                    <label class="scene-toolbar-field" for="filePreviewThemeSelect"><span>Theme</span><select class="font-select-inline" id="filePreviewThemeSelect" onchange="selectTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="docsify">Docsify</option><option value="hopscotch">Hopscotch</option><option value="graphite-light">Graphite Light</option><option value="graphite-dark">Graphite Dark</option></select></label>
                </section></div>
                <div class="scene-toolbar-menu-wrap"><button id="fileMoreBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="toggleSceneToolbarMenu('fileMoreMenu', this)" aria-label="More file actions" aria-haspopup="dialog" aria-controls="fileMoreMenu" aria-expanded="false" title="More file actions">&#8230;</button><div id="fileMoreMenu" class="scene-toolbar-popover scene-more-menu" role="dialog" aria-label="More file actions" hidden>
                    <button id="filePreviewRefreshBtn" type="button" class="scene-toolbar-menu-action" onclick="closeSceneToolbarMenus();refreshFilePreview()"><span aria-hidden="true">&#8635;</span> Refresh from disk</button>
