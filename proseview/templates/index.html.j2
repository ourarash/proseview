<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Manuscript Dashboard</title>
    <script id="proseview-bootstrap">
        (function() {
            const storedKey = 'proseview-theme';
            let theme = 'light';
            try {
                // Must stay in step with THEME_ORDER in 00-state.js. This runs
                // before any other script so the theme is set before first
                // paint, so it cannot read THEME_ORDER directly -- a value
                // missing here is silently rejected on load and the reader's
                // choice resets to light. test_themes.py guards the pair.
                const allowed = ['light', 'dark', 'docsify', 'hopscotch',
                                 'graphite-light', 'graphite-dark'];
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) {
                    theme = stored;
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (err) {
                theme = 'light';
            }
            document.documentElement.dataset.theme = theme;
        })();
        (function() {
            const storedKey = 'proseview-font';
            // Must stay in step with FONT_ORDER in 00-state.js and the
            // #modalFontSelect options below. This runs before any other
            // script so the font is set before first paint, so it cannot read
            // FONT_ORDER directly -- a value missing here is silently rejected
            // on load and the reader's choice resets to 'reader'.
            const allowed = ['reader', 'literary', 'inter', 'georgia', 'baskerville', 'sans', 'mono'];
            let font = 'reader';
            try {
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) font = stored;
            } catch (err) {
                font = 'reader';
            }
            document.documentElement.dataset.font = font;
        })();
        (function() {
            try {
                if (localStorage.getItem('proseview-sidebar') === 'closed') {
                    document.documentElement.dataset.sidebar = 'closed';
                }
            } catch (err) {
                // Ignore storage errors and keep the default open state.
            }
        })();
    </script>
    <script src="/vendor/chart.js"></script>
    <script src="/vendor/chartjs-plugin-annotation.js"></script>
    <script src="/vendor/marked.js"></script>
    <link rel="stylesheet" href="/vendor/xterm.css">
    <script src="/vendor/xterm.js"></script>
    <script src="/vendor/xterm-addon-fit.js"></script>
    <style id="proseview-app-css">
{{ app_css | safe }}
    </style>
</head>
<body>
    <nav id="repoSidebar" class="repo-sidebar" aria-label="Repository files">
        <div class="sidebar-header">
            <span class="sidebar-title">Files</span>
            <button class="sidebar-close-btn" onclick="setSidebarOpen(false)" title="Close sidebar" aria-label="Close sidebar">&times;</button>
        </div>
        <div id="sidebarTree" class="repo-tree sidebar-tree"></div>
        <div class="sidebar-resize-handle" id="sidebarResizeHandle" role="separator" tabindex="0" aria-label="Resize file browser" aria-orientation="vertical" aria-valuemin="160" aria-valuemax="520" aria-valuenow="260"></div>
    </nav>

    <main id="mainContent">
    <header class="top-banner">
        <div class="dashboard-identity"><h1>Proseview</h1><span>Your manuscript at a glance</span></div>
        <div class="banner-stat"><span class="label">Total Words</span><span class="value">{{ total_words_text }} / {{ target_words_text }}</span></div>
        <div class="banner-stat banner-progress"><span class="label">Goal Progress: {{ percent_target_text }}%</span><div class="range-bar" style="margin-top:8px;"><div class="target-zone" style="background:var(--banner-progress-fill); width:{{ percent_target_width }}%;"></div></div></div>
        <div class="banner-stat"><span class="label">Scenes</span><span class="value">{{ scene_count }}</span></div>
        <div class="banner-stat banner-finish"><span class="label">Est. Finish</span><span class="value">{{ days_to_finish }} days</span></div>
        {{ goals_banner_html | safe }}
    </header>

    <div class="app-toolbar">
        <nav class="tab-nav" aria-label="Dashboard sections">
            <button class="active" data-tab="overview" aria-current="page" onclick="showTab('overview')">Overview</button>
            <button data-tab="analysis" onclick="showTab('analysis')">Analysis</button>
            <button data-tab="timeline" onclick="showTab('timeline')">Timeline</button>
            <button data-tab="todos" onclick="showTab('todos')">TODOs</button>
            <button data-tab="notes" onclick="showTab('notes')">Notes</button>
        </nav>
        <div class="toolbar-actions">
            <button id="sidebarOpenBtn" class="sidebar-open-btn" onclick="setSidebarOpen(true)" title="Show file browser">&#9776; Files</button>
            <div id="dashboardSearchMount" class="dashboard-search-mount">
                <div id="searchMenu" class="search-menu">
                    <div class="search-palette-header">
                        <div class="search-palette-header-copy"><strong id="searchPaletteTitle">Search repository</strong><span>Esc to close</span></div>
                        <button type="button" class="search-palette-close" onclick="_closeSearch()" aria-label="Close search" title="Close search">&times;</button>
                    </div>
                    <label class="sr-only" for="searchBox">Search scenes, files, tasks, and prose</label>
                    <input id="searchBox" class="search-box" type="text" placeholder="Search scenes, files, tasks, and prose…" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="searchResults" aria-expanded="false">
                    <div id="searchNavigationWarning" class="search-navigation-warning" role="alert" hidden></div>
                    <div id="searchResults" class="search-results" role="listbox" aria-label="Search results" hidden></div>
                    <div id="searchStatus" class="sr-only" aria-live="polite"></div>
                </div>
            </div>
            <div id="fontMenu" class="font-menu">
                <button id="fontToggle" class="theme-toggle" type="button" onclick="toggleFontMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick reading font">
                    <span class="theme-toggle-kicker">Font</span>
                    <span id="fontToggleLabel" class="theme-toggle-label">Reader</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="fontMenuList" class="font-menu-list" role="listbox" aria-label="Reading font">
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="reader" onmouseenter="previewFont('reader')" onclick="selectFont('reader')">Reader</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="literary" onmouseenter="previewFont('literary')" onclick="selectFont('literary')">Literary</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="inter" onmouseenter="previewFont('inter')" onclick="selectFont('inter')">Inter</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="georgia" onmouseenter="previewFont('georgia')" onclick="selectFont('georgia')">Georgia</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="baskerville" onmouseenter="previewFont('baskerville')" onclick="selectFont('baskerville')">Baskerville</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="sans" onmouseenter="previewFont('sans')" onclick="selectFont('sans')">Sans</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="mono" onmouseenter="previewFont('mono')" onclick="selectFont('mono')">Mono</li>
                </ul>
            </div>
            <div id="themeMenu" class="theme-menu">
                <button id="themeToggle" class="theme-toggle" type="button" onclick="toggleThemeMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick color theme">
                    <span class="theme-toggle-kicker">Theme</span>
                    <span id="themeToggleLabel" class="theme-toggle-label">Light</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="themeMenuList" class="theme-menu-list" role="listbox" aria-label="Color theme">
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="light" onmouseenter="previewTheme('light')" onclick="selectTheme('light')">Light</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="dark" onmouseenter="previewTheme('dark')" onclick="selectTheme('dark')">Dark</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="docsify" onmouseenter="previewTheme('docsify')" onclick="selectTheme('docsify')">Docsify</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="hopscotch" onmouseenter="previewTheme('hopscotch')" onclick="selectTheme('hopscotch')">Hopscotch</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-light" onmouseenter="previewTheme('graphite-light')" onclick="selectTheme('graphite-light')">Graphite Light</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-dark" onmouseenter="previewTheme('graphite-dark')" onclick="selectTheme('graphite-dark')">Graphite Dark</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="tab-overview" class="tab-panel active">
        {{ goals_card_wrapper | safe }}
        {{ recent_changes_card | safe }}

        <div class="dashboard-grid">
            <figure class="card chart-figure" aria-labelledby="presenceChartTitle"><div class="card-header"><h2 class="card-title" id="presenceChartTitle">Character Presence Timeline</h2></div><div class="chart-frame"><canvas id="presenceChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
            <figure class="card chart-figure" aria-labelledby="locationChartTitle"><div class="card-header"><h2 class="card-title" id="locationChartTitle">Setting Stickiness (Words per Location)</h2></div><div class="chart-frame"><canvas id="locationChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
        </div>

        <div class="dashboard-grid" style="grid-template-columns: 1fr;">
            <figure class="card chart-figure" aria-labelledby="coOccurChartTitle"><div class="card-header"><h2 class="card-title" id="coOccurChartTitle">Character Co-Occurrence</h2></div><div class="chart-frame"><canvas id="coOccurChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
        </div>

        <div class="card" style="padding:0; overflow:hidden;"><div class="card-header" style="margin:20px 24px;"><h2 class="card-title">Scenes</h2>
            <select id="issueFilter" class="issue-filter" onchange="applyIssueFilter()">
                <option value="all">All Scenes</option><option value="todos">Has TODOs</option><option value="notes">Has Notes</option><option disabled>──────</option><option value="status-draft">Status: Draft</option><option value="status-revision">Status: Revision</option><option value="status-done">Status: Done</option><option value="status-unknown">Status: Unknown</option>
            </select>
            <span class="section-note" style="margin-left:12px;">Prose metrics live in the <a href="#" onclick="showTab('analysis'); return false;">Analysis</a> tab.</span></div>
            <table id="sceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(1)" aria-label="Sort by Chapter">Chapter</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(2)" aria-label="Sort by Words">Words</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(3)" aria-label="Sort by Flavor">Flavor</button></th></tr></thead><tbody>
                {{ table_body | safe }}
            </tbody></table></div>
    </div>

    <div id="tab-analysis" class="tab-panel">
        <p id="analysisStatus" class="section-note" role="status" aria-live="polite">Preparing the analysis…</p>
        <div id="analysisContent" hidden>
            <div class="dashboard-grid">
                <section class="card"><div class="card-header"><h2 class="card-title">Editorial Alerts</h2></div>
                    <div class="scroll-panel" id="analysisAlerts"></div>
                </section>
                <section class="card"><div class="card-header"><h2 class="card-title">Book-Wide Lexical Health</h2></div>
                    <div class="health-section"><div>Local Variety (MATTR): <strong id="analysisMattrText"></strong></div><div class="range-bar"><div class="target-zone" id="analysisMattrZone"></div><div class="current-marker" id="analysisMattrMarker"></div></div></div>
                    <div class="health-section"><div>Whole-Scene Variety (MTLD): <strong id="analysisMtldText"></strong></div><div class="range-bar"><div class="target-zone" id="analysisMtldZone"></div><div class="current-marker" id="analysisMtldMarker"></div></div></div>
                </section>
            </div>

            <div class="dashboard-grid" style="grid-template-columns: 1fr;">
                <figure class="card chart-figure" aria-labelledby="rhythmChartTitle"><div class="card-header"><h2 class="card-title" id="rhythmChartTitle">Rhythm &amp; Pacing (Sentence length variety)</h2></div>
                    <div class="section-note">
                        Measures the "pulse" of your prose.
                        <br>&bull; <b>Static (0-4):</b> Monotonous drone.
                        <br>&bull; <b>Rhythmic (5-12):</b> Healthy pulse. <b>Your current target.</b>
                        <br>&bull; <b>Dynamic (13+):</b> High contrast/tension.
                    </div>
                    <div class="chart-frame"><canvas id="rhythmChart" aria-hidden="true"></canvas></div><div class="chart-data"></div>
                </figure>
            </div>

            <div class="stats-layout">
                <section class="card" style="padding:0; overflow:hidden;"><div class="card-header" style="margin:20px 24px;"><h2 class="card-title">Scene Deep Dive</h2>
                    <select id="analysisIssueFilter" class="issue-filter" onchange="applyAnalysisIssueFilter()">
                        <option value="all">All Scenes</option><option value="repetition">Repetitive</option><option value="clipped">Clipped</option><option value="talky">Talky</option><option value="dense">Dense</option><option value="todos">Has TODOs</option><option value="notes">Has Notes</option>
                    </select></div>
                    <table id="analysisSceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(1)" aria-label="Sort by Chapter">Chapter</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(2)" aria-label="Sort by Words">Words</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(3)" aria-label="Sort by Variety">Variety</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(4)" aria-label="Sort by Flavor">Flavor</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(5)" aria-label="Sort by Top Repeat">Top Repeat</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(6)" aria-label="Sort by Dialogue percent">Dlg%</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(7)" aria-label="Sort by Sentence length">Sent</button></th></tr></thead><tbody id="analysisTableBody"></tbody></table></section>
                <div class="sticky-sidebar"><figure class="card chart-figure" aria-labelledby="lexicalScatterChartTitle"><div class="card-header"><h2 class="card-title" id="lexicalScatterChartTitle">Lexical Health Map</h2></div><div class="chart-frame-lg"><canvas id="lexicalScatterChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure></div>
            </div>
        </div>
    </div>

    <div id="tab-timeline" class="tab-panel">
        <div id="timelineContent"></div>
    </div>

    <div id="tab-todos" class="tab-panel">
        <div id="todosTabContent"></div>
    </div>

    <div id="tab-notes" class="tab-panel">
        <div class="notes-toolbar">
            <select id="notesTagFilter" class="notes-filter" onchange="filterNotes()">
                <option value="all">All Tags</option>
                <option value="note">Note</option>
                <option value="continuity">Continuity</option>
                <option value="character">Character</option>
                <option value="theme">Theme</option>
                <option value="question">Question</option>
            </select>
        </div>
        <div id="notesTabContent"></div>
    </div>

    <div id="file-preview-panel">
        <div class="file-preview-header">
            <button class="back-btn" onclick="closeFilePreview()">&#8592; Overview</button>
            <div style="min-width:0; flex:1;">
                <h1 id="filePreviewTitle" class="repo-preview-path" tabindex="-1"></h1>
                <div id="filePreviewMeta" class="repo-preview-sub"></div>
            </div>
            <div class="file-preview-controls">
                <button type="button" class="editor-btn" onclick="focusSearch()" aria-label="Search files" aria-keyshortcuts="Meta+K Control+K">Search</button>
                <select id="filePreviewFontSelect" class="font-select-inline" onchange="selectFont(this.value)" title="Reading font">
                    <option value="reader">Reader</option>
                    <option value="literary">Literary</option>
                    <option value="inter">Inter</option>
                    <option value="georgia">Georgia</option>
                    <option value="baskerville">Baskerville</option>
                    <option value="sans">Sans</option>
                    <option value="mono">Mono</option>
                </select>
                <select id="filePreviewThemeSelect" class="font-select-inline" onchange="selectTheme(this.value)" title="Color theme">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="docsify">Docsify</option>
                    <option value="hopscotch">Hopscotch</option><option value="graphite-light">Graphite Light</option><option value="graphite-dark">Graphite Dark</option>
                </select>
                <a id="filePreviewEditorBtn" class="editor-btn" href="#" target="_blank" style="flex-shrink:0;" title=""></a>
                <button type="button" class="editor-btn" id="filePreviewRefreshBtn" onclick="refreshFilePreview()" title="Refresh file preview" style="flex-shrink:0; cursor:pointer;">&#x21BB;</button><button type="button" class="editor-btn discuss-open-btn" onclick="toggleScenePanel(this)" style="flex-shrink:0; cursor:pointer;" title="Show or hide the scene panel">&#9707; Panel</button><div class="agent-menu-wrap" style="position:relative;display:inline-block;flex-shrink:0;"><button type="button" class="editor-btn" id="agentMenuFileBtn" onclick="toggleAgentMenu('file')" style="cursor:pointer;">Agents &#x25BE;</button><div id="agentMenuFile" class="skills-dropdown" style="display:none;right:0;left:auto;top:calc(100% + 6px);bottom:auto;"><button type="button" class="skills-dropdown-item" onclick="openFileInCodex();closeAgentMenus()">&#x26A1; Codex</button><button type="button" class="skills-dropdown-item" onclick="openFileInClaude();closeAgentMenus()">&#x2728; Claude</button><button type="button" class="skills-dropdown-item" onclick="openFileInGemini();closeAgentMenus()">&#x2756; Gemini</button></div></div><button type="button" class="editor-btn" onclick="openShellTerminal()" style="flex-shrink:0; cursor:pointer;">$ Shell</button>
            </div>
        </div>
        <div id="filePreviewBody" class="modal-body repo-preview-body"></div>
    </div>
    </main>

    <dialog id="searchPalette" class="search-palette" aria-labelledby="searchPaletteTitle"></dialog>


        <div id="sceneModal" class="modal" role="main" aria-labelledby="modalTitle"><div class="modal-content"><header class="modal-header" data-toolbar-mode="auto" data-toolbar-hidden="false"><div class="modal-header-inner">
            <div class="scene-toolbar-leading"><button type="button" class="scene-back-btn scene-toolbar-button" onclick="closeSceneModal()" aria-label="Close scene and return to dashboard" title="Return to dashboard"><span aria-hidden="true">&#8592;</span><span class="scene-toolbar-button-label">Dashboard</span></button><button id="modalSidebarBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="setSidebarOpen(document.documentElement.dataset.sidebar==='closed')" aria-label="Toggle file browser" aria-keyshortcuts="B" title="Toggle file browser (B)">&#9776;</button></div>
            <h1 id="modalTitle" tabindex="-1"></h1>
            <div class="modal-header-controls">
                <div class="scene-toolbar-nav" aria-label="Scene navigation"><button type="button" class="nav-btn scene-toolbar-button" onclick="navigateScene(-1)" aria-label="Previous scene" title="Previous scene">&#8592;</button><button type="button" class="nav-btn scene-toolbar-button" onclick="navigateScene(1)" aria-label="Next scene" title="Next scene">&#8594;</button></div>
                <button type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="focusSearch()" aria-label="Search files" aria-keyshortcuts="Meta+K Control+K" title="Search files">&#8981;</button>
                <button type="button" class="scene-toolbar-button discuss-open-btn" onclick="openDiscuss(this)" aria-label="Discuss"><span aria-hidden="true">&#9671;</span><span class="scene-toolbar-action-label">Discuss</span></button>
                <button id="sceneEditBtn" type="button" class="scene-toolbar-button" onclick="toggleSceneEdit()" aria-label="Edit scene" aria-keyshortcuts="E"><span aria-hidden="true">&#9998;</span><span class="scene-toolbar-action-label">Edit</span></button>
                <div class="scene-toolbar-menu-wrap"><button id="sceneAppearanceBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="toggleSceneToolbarMenu('sceneAppearanceMenu', this)" aria-label="Appearance and toolbar settings" aria-haspopup="dialog" aria-controls="sceneAppearanceMenu" aria-expanded="false" title="Appearance and toolbar settings">Aa</button><section id="sceneAppearanceMenu" class="scene-toolbar-popover scene-appearance-menu" role="dialog" aria-label="Appearance and toolbar settings" hidden>
                    <div class="scene-toolbar-menu-heading">Reading appearance</div>
                    <label class="scene-toolbar-field scene-toolbar-size-field" for="modalFontSize"><span>Text size</span><input id="modalFontSize" type="range" min="12" max="36" value="18" oninput="updateFontSize(this.value)"></label>
                    <label class="scene-toolbar-field scene-toolbar-size-field" for="modalMeasure"><span>Line width</span><input id="modalMeasure" type="range" min="480" max="1100" step="20" value="760" oninput="updateReadingMeasure(this.value)"><output id="modalMeasureOut" for="modalMeasure"></output></label>
                    <label class="scene-toolbar-field" for="modalFontSelect"><span>Font</span><select class="font-select-inline" id="modalFontSelect" onchange="selectFont(this.value)"><option value="reader">Reader</option><option value="literary">Literary</option><option value="inter">Inter</option><option value="georgia">Georgia</option><option value="baskerville">Baskerville</option><option value="sans">Sans</option><option value="mono">Mono</option></select></label>
                    <label class="scene-toolbar-field" for="modalThemeSelect"><span>Theme</span><select class="font-select-inline" id="modalThemeSelect" onchange="selectTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="docsify">Docsify</option><option value="hopscotch">Hopscotch</option><option value="graphite-light">Graphite Light</option><option value="graphite-dark">Graphite Dark</option></select></label>
                    <button id="modalLineNumbersBtn" type="button" class="scene-toolbar-menu-action" onclick="toggleLineNumbers()" aria-pressed="false" title="Show source line numbers"><span aria-hidden="true">#</span> Source line numbers</button>
                    <fieldset class="scene-toolbar-mode-field"><legend>Toolbar visibility</legend><label><input type="radio" name="sceneToolbarMode" value="auto" onchange="setSceneToolbarMode(this.value)"><span>Auto-hide</span></label><label><input type="radio" name="sceneToolbarMode" value="pinned" onchange="setSceneToolbarMode(this.value)"><span>Always show</span></label><label><input type="radio" name="sceneToolbarMode" value="hidden" onchange="setSceneToolbarMode(this.value)"><span>Hidden</span></label></fieldset>
                </section></div>
                <div id="modalHeaderExtras" class="scene-toolbar-menu-wrap"><button id="sceneMoreBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="toggleSceneToolbarMenu('sceneMoreMenu', this)" aria-label="More scene actions" aria-haspopup="dialog" aria-controls="sceneMoreMenu" aria-expanded="false" title="More scene actions">&#8230;</button><div id="sceneMoreMenu" class="scene-toolbar-popover scene-more-menu" role="dialog" aria-label="More scene actions" hidden>
                    <button id="modalRefreshBtn" type="button" class="scene-toolbar-menu-action" onclick="closeSceneToolbarMenus();refreshContent()"><span aria-hidden="true">&#8635;</span> Refresh from disk</button>
                    <a id="modalEditorBtn" class="scene-toolbar-menu-action" target="_blank" title="Open in {{ editor_label }}"><span aria-hidden="true">&#8599;</span> Open in {{ editor_label }}</a>
                    <button id="modalFocusBtn" type="button" class="scene-toolbar-menu-action" onclick="closeSceneToolbarMenus();toggleFocusMode()" aria-pressed="false" aria-keyshortcuts="F"><span aria-hidden="true">&#9681;</span> Focus layout</button>
