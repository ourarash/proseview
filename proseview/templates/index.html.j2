                <button type="button" id="bookViewPrint" role="radio" aria-checked="false" onclick="setBookLayout(true)" title="The book as Export prints it, page by page">Print layout</button>
            </div>
            <div class="file-preview-controls">
                <button type="button" id="bookFocusBtn" class="back-btn book-focus-btn" onclick="toggleBookFocus()" aria-pressed="false" aria-keyshortcuts="F" aria-label="Focus" title="Hide the bars to see the pages larger (F; Shift+F for full screen)" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg></button>
                <div class="scene-toolbar-menu-wrap"><button id="bookAppearanceBtn" type="button" class="back-btn book-appearance-btn" onclick="toggleSceneToolbarMenu('bookAppearanceMenu', this)" aria-label="Reading appearance" aria-haspopup="dialog" aria-controls="bookAppearanceMenu" aria-expanded="false" title="Text size, line width, font and theme">Aa</button><section id="bookAppearanceMenu" class="scene-toolbar-popover scene-appearance-menu" role="dialog" aria-label="Reading appearance" hidden>
                    <div class="scene-toolbar-menu-heading">Reading appearance</div>
                    <label class="scene-toolbar-field scene-toolbar-size-field" for="bookFontSize"><span>Text size</span><input id="bookFontSize" type="range" min="12" max="36" value="18" oninput="updateFontSize(this.value)"></label>
                    <label class="scene-toolbar-field scene-toolbar-size-field" for="bookMeasure"><span>Line width</span><input id="bookMeasure" type="range" min="480" max="1100" step="20" value="760" oninput="updateReadingMeasure(this.value)"><output id="bookMeasureOut" for="bookMeasure"></output></label>
                    <label class="scene-toolbar-field" for="bookFontSelect"><span>Font</span><select class="font-select-inline" id="bookFontSelect" onchange="selectFont(this.value)"><option value="reader">Reader</option><option value="literary">Literary</option><option value="inter">Inter</option><option value="georgia">Georgia</option><option value="baskerville">Baskerville</option><option value="sans">Sans</option><option value="mono">Mono</option></select></label>
                    <div id="bookPrintFields" class="book-print-fields">
                        <label class="scene-toolbar-field" for="bookPrintStyle"><span>Style</span><select class="font-select-inline" id="bookPrintStyle" onchange="setBookPrintLayout()"></select></label>
                        <label class="scene-toolbar-field" for="bookPrintFormat"><span>PDF</span><select class="font-select-inline" id="bookPrintFormat" onchange="setBookPrintLayout()"><option value="pdf-print">Print book</option><option value="pdf-share">Shareable</option></select></label>
                        <label class="scene-toolbar-field" for="bookPrintTrim" id="bookPrintTrimField"><span>Trim</span><select class="font-select-inline" id="bookPrintTrim" onchange="setBookPrintLayout()"></select></label>
                        <label class="scene-toolbar-field" for="bookPrintPaper" id="bookPrintPaperField"><span>Paper</span><select class="font-select-inline" id="bookPrintPaper" onchange="setBookPrintLayout()"></select></label>
                        <p id="bookPrintNote" class="book-print-note"></p>
                    </div>
                    <label class="scene-toolbar-field" for="bookThemeSelect"><span>Theme</span><select class="font-select-inline" id="bookThemeSelect" onchange="selectTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="docsify">Docsify</option><option value="hopscotch">Hopscotch</option><option value="graphite-light">Graphite Light</option><option value="graphite-dark">Graphite Dark</option></select></label>
                </section></div>
                <button type="button" id="bookEditBtn" class="file-edit-btn" onclick="openBookScene(bookCurrentScene(), true)" aria-keyshortcuts="E" title="Edit the scene you are reading (E)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg><span>Edit</span></button>
            </div>
        </div>
        <div id="bookIntro" class="book-intro" role="status" hidden>
            <p><strong>Reading mode.</strong> The whole book as one continuous text: every scene, in order, without the dashboard. Scroll to read, or skip by scene and chapter from the bar at the bottom (&larr; &rarr;). To change a scene, choose Edit beside it.</p>
            <button type="button" class="book-intro-close" onclick="dismissBookIntro()" aria-label="Dismiss">&times;</button>
        </div>
        <div id="bookBody" class="modal-body book-body"></div>
        <div id="bookPages" class="book-pages" role="region" aria-label="The book in print layout" hidden></div>
        <nav id="bookNav" class="book-nav" aria-label="Move through the book">
            <div class="book-nav-progress" aria-hidden="true"><span id="bookNavBar"></span></div>
            <div class="book-nav-row">
                <button type="button" class="book-nav-btn" onclick="bookGoChapter(-1)" aria-label="Previous chapter" title="Previous chapter (Shift+&larr;)">&laquo;</button>
                <button type="button" class="book-nav-btn" onclick="bookGoScene(-1)" aria-label="Previous scene" title="Previous scene (&larr;)">&lsaquo;</button>
                <div class="book-nav-where-wrap">
                    <button type="button" id="bookNavWhere" class="book-nav-where" onclick="toggleBookToc()" aria-haspopup="true" aria-expanded="false" aria-controls="bookToc" title="Chapters"></button>
                    <div id="bookToc" class="book-toc" role="group" aria-label="Chapters" hidden></div>
                </div>
                <button type="button" class="book-nav-btn" onclick="bookGoScene(1)" aria-label="Next scene" title="Next scene (&rarr;)">&rsaquo;</button>
                <button type="button" class="book-nav-btn" onclick="bookGoChapter(1)" aria-label="Next chapter" title="Next chapter (Shift+&rarr;)">&raquo;</button>
                <span id="bookNavPct" class="book-nav-pct" aria-label="Read so far"></span>
                <div id="bookPagesNav" class="book-pages-nav" hidden>
                    <button type="button" id="bookPagesPrev" class="book-nav-btn" aria-label="Previous page" title="Previous page (&larr;)">&lsaquo;</button>
                    <label class="sr-only" for="bookPagesPick">Go to</label>
                    <select id="bookPagesPick" class="book-pages-pick"></select>
                    <button type="button" id="bookPagesNext" class="book-nav-btn" aria-label="Next page" title="Next page (&rarr;)">&rsaquo;</button>
                    <span id="bookPagesStatus" class="book-pages-status" aria-live="polite"></span>
                </div>
            </div>
        </nav>
    </div>
    </main>

    <dialog id="settingsDialog" class="settings-dialog" aria-labelledby="settingsTitle">
        <section class="card settings-page" aria-labelledby="settingsTitle">
            <div class="settings-resize" role="separator" aria-orientation="vertical" aria-label="Settings width" tabindex="0" title="Drag to change the width. Double-click for the default."></div>
            <div class="settings-head">
                <h2 id="settingsTitle" class="card-title">Settings</h2>
                <span class="settings-head-actions">
                    <button type="button" id="settingsSaveBtn" class="primary-button" onclick="saveSettings()" disabled>Save changes</button>
                    <button type="button" class="ledger-close" onclick="closeSettings()" aria-label="Close settings">&times;</button>
                </span>
            </div>
            <div class="settings-tabs" role="tablist" aria-label="Settings sections">
                <button type="button" role="tab" id="settingsTabGeneral" class="settings-tab" aria-selected="true" aria-controls="settingsPanelGeneral" onclick="selectSettingsTab('general')">General</button>
                <button type="button" role="tab" id="settingsTabSuggestions" class="settings-tab" aria-selected="false" aria-controls="settingsPanelSuggestions" tabindex="-1" onclick="selectSettingsTab('suggestions')">Suggestions</button>
                <button type="button" role="tab" id="settingsTabRoom" class="settings-tab" aria-selected="false" aria-controls="settingsPanelRoom" tabindex="-1" onclick="selectSettingsTab('room')">Writers’ Room</button>
            </div>
            <div id="settingsPanelGeneral" role="tabpanel" aria-labelledby="settingsTabGeneral">
            {% if not config_exists %}
            <p id="settingsEmptyBanner" class="settings-note">Proseview is using its default settings. Saving creates a <code>.proseview.yaml</code> file in your book's folder.</p>
            {% endif %}

            <h3 class="settings-section">Your book</h3>
            <div class="settings-row">
                <label for="setting_target_words">Book goal<span class="info-tip" tabindex="0" role="img" aria-label="How many words you want the finished book to have. Progress on the Overview is measured against it." data-tip="How many words you want the finished book to have. Progress on the Overview is measured against it.">i</span></label>
                <span class="settings-field"><input type="number" id="setting_target_words" class="settings-input" min="0" step="1000" value="{{ cfg.target_words }}" oninput="markSettingsDirty()"> <span class="settings-unit">words</span></span>
            </div>
            <div class="settings-row">
                <label for="setting_daily_target">Daily goal<span class="info-tip" tabindex="0" role="img" aria-label="How many words a day you aim to write. It sets the days-to-finish figure." data-tip="How many words a day you aim to write. It sets the days-to-finish figure.">i</span></label>
                <span class="settings-field"><input type="number" id="setting_daily_target" class="settings-input" min="0" step="50" value="{{ cfg.daily_target }}" oninput="markSettingsDirty()"> <span class="settings-unit">words a day</span></span>
            </div>
            <div class="settings-row settings-variety">
                <label for="setting_variety">Word variety<span class="settings-hint">What counts as typical for Variety and MTLD in the Analysis tab. Values outside it turn amber.</span></label>
                <span class="settings-field">
                    {%- macro variety_option(id, label, mtld) -%}
                    <option value="{{ id }}"{% if bands.preset == id %} selected{% endif %}>{{ label }} · Variety {{ '%g' % bands.mattrDefault[0] }}–{{ '%g' % bands.mattrDefault[1] }} · MTLD {{ '%g' % mtld[0] }}–{{ '%g' % mtld[1] }}</option>
                    {%- endmacro %}
                    <select id="setting_variety" class="settings-input" onchange="pickVariety()">
                        {%- for p in bands.presets %}
                        {{ variety_option(p.id, p.label, p.mtld) }}
                        {%- endfor %}
                        <option value="custom"{% if bands.preset == 'custom' %} selected{% endif %}>Custom…</option>
                    </select>
                </span>
            </div>
            <div id="settingVarietyCustom" class="settings-variety-custom"{% if bands.preset != 'custom' %} hidden{% endif %}>
                <span class="settings-variety-line">Variety from <input type="number" id="setting_mattr_low" class="settings-input" aria-label="Variety from" min="0" max="1" step="0.01" value="{{ '%g' % bands.mattr[0] }}" oninput="editVariety()"> to <input type="number" id="setting_mattr_high" class="settings-input" aria-label="Variety to" min="0" max="1" step="0.01" value="{{ '%g' % bands.mattr[1] }}" oninput="editVariety()"></span>
                <span class="settings-variety-line">MTLD from <input type="number" id="setting_mtld_low" class="settings-input" aria-label="MTLD from" min="1" max="1000" step="1" value="{{ '%g' % bands.mtld[0] }}" oninput="editVariety()"> to <input type="number" id="setting_mtld_high" class="settings-input" aria-label="MTLD to" min="1" max="1000" step="1" value="{{ '%g' % bands.mtld[1] }}" oninput="editVariety()"></span>
            </div>

            <h3 class="settings-section">Appearance</h3>
            <div class="settings-row">
                <span class="settings-label">Color theme<span class="info-tip" tabindex="0" role="img" aria-label="How Proseview looks on this computer. Saved in this browser, not in your book." data-tip="How Proseview looks on this computer. Saved in this browser, not in your book.">i</span></span>
                <span class="settings-field">
                    <div id="themeMenu" class="theme-menu">
                        <button id="themeToggle" class="theme-toggle" type="button" onclick="toggleThemeMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick color theme">
                            <span class="theme-toggle-kicker">Theme</span>
                            <span id="themeToggleLabel" class="theme-toggle-label">Light</span>
                            <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                        </button>
                        <ul id="themeMenuList" class="theme-menu-list" role="listbox" aria-label="Color theme">
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="light" onmouseenter="previewTheme('light')" onclick="selectTheme('light')">Light</li>
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="dark" onmouseenter="previewTheme('dark')" onclick="selectTheme('dark')">Dark</li>
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="docsify" onmouseenter="previewTheme('docsify')" onclick="selectTheme('docsify')">Docsify</li>
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="hopscotch" onmouseenter="previewTheme('hopscotch')" onclick="selectTheme('hopscotch')">Hopscotch</li>
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-light" onmouseenter="previewTheme('graphite-light')" onclick="selectTheme('graphite-light')">Graphite Light</li>
                            <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-dark" onmouseenter="previewTheme('graphite-dark')" onclick="selectTheme('graphite-dark')">Graphite Dark</li>
                        </ul>
                    </div>
                </span>
            </div>

            {% if not static_snapshot %}
            {#- Shown by 03-privacy.js once the server says a password can be kept here. #}
            <div class="settings-row" id="privacySettingsRow" hidden>
                <span class="settings-label">Privacy screen<span class="info-tip" tabindex="0" role="img" aria-label="Cmd + J J (Ctrl + J J on Windows and Linux) covers the page with a plain spreadsheet; the same again uncovers it. It stays covered through a reload until uncovered. A password is asked before uncovering. Only a hash of it is kept, on this computer, never in your book." data-tip="Cmd + J J (Ctrl + J J on Windows and Linux) covers the page with a plain spreadsheet; the same again uncovers it. It stays covered through a reload until uncovered. A password is asked before uncovering. Only a hash of it is kept, on this computer, never in your book.">i</span></span>
                <span class="settings-field">
                    <span id="privacyPasswordStatus" class="settings-unit">Password: none</span>
                    <button type="button" id="privacySetBtn" class="settings-plain-btn" onclick="privacySettingsForm('set')">Set password</button>
                    <button type="button" id="privacyChangeBtn" class="settings-plain-btn" onclick="privacySettingsForm('change')" hidden>Change</button>
                    <button type="button" id="privacyRemoveBtn" class="settings-danger-btn" onclick="privacySettingsForm('remove')" hidden>Remove</button>
                </span>
            </div>
            <form id="privacyPasswordForm" class="settings-row privacy-password-form" hidden onsubmit="event.preventDefault(); privacySettingsSubmit();">
                <span class="settings-field">
                    <input type="password" id="privacyCurrent" class="settings-input" placeholder="Current password" aria-label="Current password" autocomplete="current-password">
                    <input type="password" id="privacyNew" class="settings-input" placeholder="New password" aria-label="New password" autocomplete="new-password">
                    <input type="password" id="privacyNewAgain" class="settings-input" placeholder="Again" aria-label="New password again" autocomplete="new-password">
                </span>
                <span class="settings-field">
                    <span id="privacyPasswordMsg" class="settings-unit" role="status"></span>
                    <button type="button" class="settings-plain-btn" onclick="privacySettingsForm(null)">Cancel</button>
                    <button type="submit" id="privacyFormSubmit" class="settings-plain-btn">Set</button>
                </span>
            </form>
            {% endif %}

            <details class="settings-advanced">
                <summary>Advanced</summary>
                <div class="settings-row">
                    <span class="settings-label">Settings file</span>
                    <span class="settings-field">{% if config_exists %}<a href="{{ yaml_editor_url }}">Open <code>.proseview.yaml</code> in your editor</a>{% else %}<code>.proseview.yaml</code> (created when you save){% endif %}</span>
                </div>
                <div class="settings-row">
                    <span class="settings-label">Characters</span>
                    <span class="settings-field">{{ cfg.characters|length ~ ' listed' if cfg.characters else 'Found from ' ~ cfg.characters_dir ~ '/' }}</span>
                </div>
                <div class="settings-row">
                    <span class="settings-label">Places</span>
                    <span class="settings-field">{{ cfg.locations|length ~ ' listed' if cfg.locations else "From each scene's where:" }}</span>
                </div>
                <div class="settings-row">
                    <span class="settings-label">Backups<span class="info-tip" tabindex="0" role="img" aria-label="Copies of your scenes Proseview keeps on this computer so you can undo and see each file&#x27;s history." data-tip="Copies of your scenes Proseview keeps on this computer so you can undo and see each file&#x27;s history.">i</span></span>
                    <span class="settings-field"><span id="setting_backup_size" class="settings-unit">…</span> <button type="button" class="settings-danger-btn" onclick="clearAllBackups()">Clear all backups…</button></span>
                </div>
            </details>
            </div>
            <div id="settingsPanelSuggestions" role="tabpanel" aria-labelledby="settingsTabSuggestions" hidden>
                <p class="settings-note">What Suggest on a highlight asks Codex or Claude, what they can see and use, and the model they use. Model, tools and MCP servers are kept on this computer; files and prompts are saved in your book's <code>.proseview.yaml</code>.</p>
                <div id="suggestionSettingsBody" class="suggestion-settings-body"><p class="settings-unit">Loading…</p></div>
            </div>
            <div id="settingsPanelRoom" role="tabpanel" aria-labelledby="settingsTabRoom" hidden>
                <p class="settings-note">Choose agent profiles and discussion presets for the Writers’ Room. Each participant has their normal chat tools and project access. Use @mentions to address someone, or invite both with an untagged message.</p>
                <div id="roomSettingsBody" class="suggestion-settings-body"><p class="settings-unit">Loading…</p></div>
            </div>
        </section>
    </dialog>

    <dialog id="searchPalette" class="search-palette" aria-labelledby="searchPaletteTitle"></dialog>


        <div id="sceneModal" class="modal" role="main" aria-labelledby="modalTitle"><div class="modal-content"><header class="modal-header" data-toolbar-mode="auto" data-toolbar-hidden="false"><div class="modal-header-inner">
            <div class="scene-toolbar-leading"><button type="button" class="scene-back-btn scene-toolbar-button" onclick="closeSceneModal()" aria-label="Close scene and return to dashboard" title="Return to dashboard"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg><span class="scene-toolbar-button-label">Dashboard</span></button><button id="modalSidebarBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="setSidebarOpen(document.documentElement.dataset.sidebar==='closed')" aria-label="Toggle file browser" aria-keyshortcuts="B" title="Toggle file browser (B)"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path></svg></button></div>
            <h1 id="modalTitle" tabindex="-1"></h1>
