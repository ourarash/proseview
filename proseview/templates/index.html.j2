                <button type="button" class="modal-close scene-toolbar-button" onclick="closeFilePreview()" aria-label="Close file and return to dashboard" title="Close file and return to dashboard">&times;</button>
            </div>
        </div></header>
        <div id="fileEditBar" class="file-edit-bar" role="region" aria-label="Editing this file" hidden>
