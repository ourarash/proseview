    <dialog id="discussNewConversationDialog" class="discuss-context-picker discuss-confirm-dialog" aria-labelledby="discussNewConversationTitle" aria-describedby="discussNewConversationDescription" aria-busy="false">
        <form method="dialog">
            <div class="discuss-picker-header"><h2 id="discussNewConversationTitle">Start a new conversation?</h2></div>
            <p id="discussNewConversationDescription">This starts a blank conversation for this document. You can reopen the current conversation later from History.</p>
            <p id="discussNewConversationStatus" class="discuss-pending-status" role="status" aria-live="polite" hidden></p>
            <p id="discussNewConversationError" class="discuss-error" role="alert" hidden></p>
            <div class="discuss-picker-actions"><button id="discussNewConversationCancel" class="discuss-secondary" value="cancel" autofocus>Keep conversation</button><button id="discussNewConversationConfirm" class="discuss-primary" value="default" onclick="confirmNewDiscussConversation(event)">Start new conversation</button></div>
        </form>
    </dialog>
    <dialog id="discussHistoryDialog" class="discuss-context-picker discuss-history-dialog" aria-labelledby="discussHistoryTitle" aria-describedby="discussHistoryDescription" aria-busy="false">
        <form method="dialog">
            <div class="discuss-picker-header"><h2 id="discussHistoryTitle">Conversation history</h2><button id="discussHistoryClose" class="discuss-secondary" value="cancel" aria-label="Close conversation history">Done</button></div>
            <p id="discussHistoryDescription">Conversations for the document you are viewing.</p>
            <p id="discussHistoryStatus" class="discuss-pending-status" role="status" aria-live="polite">Loading conversations…</p>
            <div id="discussHistoryList" class="discuss-history-list"></div>
        </form>
    </dialog>

    <script id="proseview-data">
        let contents = {{ contents_json | safe }};
        const bios = {{ bios_json | safe }};
        let meta = {{ meta_json | safe }};
        const paths = {{ paths_json | safe }};
        let highlightsByPath = {{ highlights_json | safe }};
        const editorScheme = {{ editor_scheme_json | safe }};
        const editorUrlTemplate = {{ editor_url_template_json | safe }};
        const editorLabel = {{ editor_label_json | safe }};
        const repoTree = {{ repo_tree_json | safe }};
        const sidebarTree = {{ sidebar_tree_json | safe }};
        const repositoryTree = {{ repository_tree_json | safe }};
        const repoPreviewMax = {{ repo_preview_max }};
        const pageSessionToken = {{ session_token_json | safe }};
        const repoFileByPath = {};
        const repositoryFileByPath = {};
        (function indexRepo(nodes) {
            if (!nodes) return;
            for (const node of nodes) {
                if (node.is_file) repoFileByPath[node.path] = node;
                else indexRepo(node.children);
            }
        })(repoTree);
        (function indexRepository(nodes) {
            if (!nodes) return;
            for (const node of nodes) {
                if (node.is_file) repositoryFileByPath[node.path] = node;
                else indexRepository(node.children);
            }
        })(repositoryTree);

        const PASS_ORDER = {{ pass_order_json | safe }};
        const SKILLS = {{ skills_json | safe }};
        const presenceChartData = {{ presence_chart_json | safe }};
        const rhythmChartData = {{ rhythm_chart_json | safe }};
        const locationChartData = {{ location_chart_json | safe }};
        const coOccurChartData = {{ cooccur_chart_json | safe }};
        const lexicalScatterChartData = {{ scatter_chart_json | safe }};
    </script>
    <script id="proseview-app">
{{ app_js | safe }}
    </script>
    <script type="module">
        // ProseMirror modules are pulled from esm.sh at fixed versions
        // so a major upstream release can't silently break the editor.
        // Vendoring the ESM graph would require a build step (each
        // package has transitive deps); pinning is the lightweight
        // alternative.
        import { Schema } from 'https://esm.sh/prosemirror-model@1.25.4';
        import { schema as mdSchema, MarkdownParser, MarkdownSerializer,
                 defaultMarkdownParser, defaultMarkdownSerializer } from 'https://esm.sh/prosemirror-markdown@1.13.4?deps=prosemirror-model@1.25.4';
        import { EditorState, Plugin, PluginKey, TextSelection } from 'https://esm.sh/prosemirror-state@1.4.4?deps=prosemirror-model@1.25.4,prosemirror-transform@1.10.4';
        import { EditorView, Decoration, DecorationSet } from 'https://esm.sh/prosemirror-view@1.41.8?deps=prosemirror-model@1.25.4,prosemirror-state@1.4.4,prosemirror-transform@1.10.4';
        import { history, undo, redo } from 'https://esm.sh/prosemirror-history@1.5.0?deps=prosemirror-model@1.25.4,prosemirror-state@1.4.4,prosemirror-transform@1.10.4';
        import { keymap } from 'https://esm.sh/prosemirror-keymap@1.2.3?deps=prosemirror-model@1.25.4,prosemirror-state@1.4.4,prosemirror-transform@1.10.4';
        import { baseKeymap, toggleMark } from 'https://esm.sh/prosemirror-commands@1.7.1?deps=prosemirror-model@1.25.4,prosemirror-state@1.4.4,prosemirror-transform@1.10.4';

        // Enable HTML so block-level <!-- TODO/NOTE --> comments are emitted
        // as html_block tokens, which the parser rule in 40-prose-editor.js
        // maps to annotation nodes. The default tokenizer has html:false,
        // which would otherwise pass these through as plain text and the
        // user would see the raw <!-- ... --> in the prose.
        defaultMarkdownParser.tokenizer.set({ html: true });

        const annotationSpec = {
            attrs: { raw: { default: '' } },
            inline: false, group: 'block',
            atom: true, selectable: false,
            parseDOM: [],
            toDOM(node) {
                const raw = String(node.attrs.raw || '');
                const inner = raw.replace(/^<!--\s*/, '').replace(/\s*-->$/, '').trim();
                const todoMatch = /^TODO\s*:\s*(.*)$/i.exec(inner);
                const noteMatch = /^NOTE(?:\[(\w+)\])?\s*:\s*(.*)$/i.exec(inner);
                let kind = 'note';
                let tag = 'note';
                let body = inner;
                if (todoMatch) {
                    kind = 'todo';
                    tag = 'todo';
                    body = todoMatch[1];
                } else if (noteMatch) {
                    kind = 'note';
                    tag = (noteMatch[1] || 'note').toLowerCase();
                    body = noteMatch[2];
                }
                const icon = kind === 'todo' ? '📝' : '📌';
                return ['div', {
                    class: 'pm-annotation pm-annotation-' + kind,
                    contenteditable: 'false',
                    'data-tag': tag,
                    title: body,
                }, ['span', { class: 'pm-annotation-icon' }, icon],
                   ['span', { class: 'pm-annotation-text' }, body]];
            }
        };

        function parseAnnotationRawForView(raw) {
            const text = String(raw || '');
            let m = text.match(/^<!--\s*TODO:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'todo', tag: 'TODO', body: m[1], icon: '📝' };
            m = text.match(/^<!--\s*NOTE\[(\w+)\]:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'note', tag: m[1], body: m[2], icon: '📌' };
            m = text.match(/^<!--\s*NOTE:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'note', tag: 'NOTE', body: m[1], icon: '📌' };
            return {
                kind: 'todo',
                tag: 'TODO',
                body: text.replace(/^<!--\s*/, '').replace(/\s*-->$/, ''),
                icon: '📝'
            };
        }

        function buildAnnotationRawFromView(tag, text) {
            if (tag === 'TODO') return '<!-- TODO: ' + text + ' -->';
            if (tag === 'NOTE') return '<!-- NOTE: ' + text + ' -->';
            return '<!-- NOTE[' + tag + ']: ' + text + ' -->';
        }

        class AnnotationNodeView {
            constructor(node, view, getPos) {
                this.node = node;
                this.view = view;
                this.getPos = getPos;
                this.editing = false;
                this.autoSave = false;
                this.dom = document.createElement('div');
                this.dom.contentEditable = 'false';
                this.dom._annotationStartEdit = this.startEdit.bind(this);
                this.renderRead();
            }
            parsed() {
                return parseAnnotationRawForView(this.node.attrs.raw);
            }
            setBaseClass(parsed) {
                this.dom.className = 'pm-annotation pm-annotation-' + parsed.kind + (this.editing ? ' pm-annotation-editing' : '');
                this.dom.dataset.tag = parsed.tag.toLowerCase();
                this.dom.title = this.editing ? '' : parsed.body;
            }
            renderRead() {
                const parsed = this.parsed();
                this.editing = false;
                this.setBaseClass(parsed);
                this.dom.replaceChildren();
                const icon = document.createElement('span');
                icon.className = 'pm-annotation-icon';
                icon.textContent = parsed.icon;
                const text = document.createElement('span');
                text.className = 'pm-annotation-text';
                text.textContent = parsed.body;
                this.dom.append(icon, text);
                this.dom.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    this.startEdit(!window._pmEditMode);
                };
            }
            renderEdit() {
                const parsed = this.parsed();
                this.setBaseClass(parsed);
                this.dom.replaceChildren();
                this.dom.onclick = null;

                const icon = document.createElement('span');
                icon.className = 'pm-annotation-icon';
                icon.textContent = parsed.icon;

                const form = document.createElement('div');
                form.className = 'pm-annotation-edit-body';

                const editable = document.createElement('div');
                editable.className = 'pm-annotation-text pm-annotation-edit-text';
                editable.contentEditable = 'plaintext-only';
                editable.role = 'textbox';
                editable.ariaMultiLine = 'true';
                editable.dataset.placeholder = parsed.kind === 'todo' ? 'TODO text' : 'Note text';
                editable.textContent = parsed.body;
                editable.onkeydown = (event) => {
                    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
                        event.preventDefault();
                        event.stopPropagation();
                        this.save(editable.innerText);
                    } else if (event.key === 'Escape') {
                        event.preventDefault();
                        event.stopPropagation();
                        cancel.click();
                    }
                };

                const actions = document.createElement('div');
                actions.className = 'pm-annotation-edit-actions';

                const cancel = document.createElement('button');
                cancel.type = 'button';
                cancel.className = 'pm-annotation-cancel';
                cancel.textContent = 'Cancel';
                cancel.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    const shouldExitEdit = this.autoSave && !window._pmDirty && typeof window.cancelSceneEdit === 'function';
                    this.autoSave = false;
                    this.renderRead();
                    if (shouldExitEdit) window.cancelSceneEdit();
                };

                const resolve = document.createElement('button');
                resolve.type = 'button';
                resolve.className = 'pm-annotation-delete';
                resolve.textContent = parsed.kind === 'todo' ? 'Resolve' : 'Delete';
                resolve.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    this.deleteNode();
                };

                const save = document.createElement('button');
                save.type = 'button';
                save.className = 'pm-annotation-save';
                save.textContent = 'Save';
                save.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    this.save(editable.innerText);
                };

                actions.append(cancel, resolve, save);
                form.append(editable, actions);
                this.dom.append(icon, form);

                setTimeout(() => {
                    try { editable.focus({ preventScroll: true }); }
                    catch (err) { editable.focus(); }
                    var sel = window.getSelection && window.getSelection();
                    if (sel) {
                        var range = document.createRange();
                        range.selectNodeContents(editable);
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }
                }, 0);
            }
            startEdit(autoSave) {
                const scrollEl = document.querySelector('#sceneModal .modal-content');
                const scrollTop = scrollEl ? scrollEl.scrollTop : null;
                if (!window._pmEditMode && typeof window.toggleSceneEdit === 'function') {
                    window.toggleSceneEdit();
                }
                if (scrollEl && scrollTop !== null) scrollEl.scrollTop = scrollTop;
                this.autoSave = !!autoSave;
                this.editing = true;
                this.renderEdit();
            }
            save(text) {
                const parsed = this.parsed();
                const raw = buildAnnotationRawFromView(parsed.tag, String(text || '').trim());
                const pos = this.getPos();
                const shouldAutoSave = this.autoSave;
                this.view.dispatch(this.view.state.tr.setNodeMarkup(pos, null, { raw }));
                this.editing = false;
                this.autoSave = false;
                this.renderRead();
                if (shouldAutoSave && typeof window.saveSceneEdit === 'function') window.saveSceneEdit();
            }
            deleteNode() {
                const pos = this.getPos();
                const shouldAutoSave = this.autoSave;
                this.view.dispatch(this.view.state.tr.delete(pos, pos + this.node.nodeSize));
                this.autoSave = false;
                if (shouldAutoSave && typeof window.saveSceneEdit === 'function') window.saveSceneEdit();
            }
            update(node) {
                if (node.type !== this.node.type) return false;
                this.node = node;
                if (!this.editing) this.renderRead();
                return true;
            }
            stopEvent() { return true; }
            ignoreMutation() { return true; }
            destroy() {
                delete this.dom._annotationStartEdit;
            }
        }

        function createAnnotationNodeView(node, view, getPos) {
            return new AnnotationNodeView(node, view, getPos);
        }

        const mySchema = new Schema({
            nodes: mdSchema.spec.nodes.addBefore('paragraph', 'annotation', annotationSpec),
            marks: mdSchema.spec.marks
        });

        const hlPluginKey = new PluginKey('highlights');

        function buildHlPlugin() {
            return new Plugin({
                key: hlPluginKey,
                state: {
                    init() { return DecorationSet.empty; },
                    apply(tr, set) {
                        const next = tr.getMeta(hlPluginKey);
                        if (next !== undefined) return next;
                        return set.map(tr.mapping, tr.doc);
                    }
                },
                props: {
                    decorations(state) { return hlPluginKey.getState(state); }
                }
            });
        }

        window._PM = {
            Schema, EditorState, EditorView, Plugin, PluginKey, TextSelection,
            Decoration, DecorationSet,
            mySchema, mdSchema,
            MarkdownParser, MarkdownSerializer,
            defaultMarkdownParser, defaultMarkdownSerializer,
            history, undo, redo, keymap, baseKeymap, toggleMark,
            hlPluginKey, buildHlPlugin, createAnnotationNodeView
        };

        // If the scene view is already open, re-render so it uses ProseMirror.
        if (document.documentElement.dataset.view === 'scene' && typeof render === 'function') {
            render();
        }
    </script>
</body>
</html>
