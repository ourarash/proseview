<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Manuscript Dashboard</title>
    <script id="proseview-bootstrap">
        (function() {
            const storedKey = 'proseview-theme';
            let theme = 'light';
            try {
                const stored = localStorage.getItem(storedKey);
                if (stored === 'light' || stored === 'dark' || stored === 'docsify' || stored === 'hopscotch') {
                    theme = stored;
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (err) {
                theme = 'light';
            }
            document.documentElement.dataset.theme = theme;
        })();
        (function() {
            const storedKey = 'proseview-font';
            const allowed = ['reader', 'literary', 'sans', 'mono'];
            let font = 'reader';
            try {
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) font = stored;
            } catch (err) {
                font = 'reader';
            }
            document.documentElement.dataset.font = font;
        })();
        (function() {
            try {
                if (localStorage.getItem('proseview-sidebar') === 'closed') {
                    document.documentElement.dataset.sidebar = 'closed';
                }
            } catch (err) {
                // Ignore storage errors and keep the default open state.
            }
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5/css/xterm.css" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@5/lib/xterm.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10/lib/addon-fit.min.js" crossorigin="anonymous"></script>
    <style id="proseview-app-css">
{{ app_css | safe }}
    </style>
</head>
<body>
    <nav id="repoSidebar" class="repo-sidebar">
        <div class="sidebar-header">
            <span class="sidebar-title">Files</span>
            <button class="sidebar-close-btn" onclick="setSidebarOpen(false)" title="Close sidebar">&times;</button>
        </div>
        <div id="sidebarTree" class="repo-tree sidebar-tree"></div>
        <div class="sidebar-resize-handle" id="sidebarResizeHandle"></div>
    </nav>

    <header class="top-banner">
        <div class="banner-stat"><span class="label">Total Words</span><span class="value">{{ total_words_text }} / {{ target_words_text }}</span></div>
        <div class="banner-stat banner-progress"><span class="label">Goal Progress: {{ percent_target_text }}%</span><div class="range-bar" style="margin-top:8px;"><div class="target-zone" style="background:var(--banner-progress-fill); width:{{ percent_target_width }}%;"></div></div></div>
        <div class="banner-stat"><span class="label">Scenes</span><span class="value">{{ scene_count }}</span></div>
        <div class="banner-stat banner-finish"><span class="label">Est. Finish</span><span class="value">{{ days_to_finish }} days</span></div>
        {{ goals_banner_html | safe }}
    </header>

    <div class="app-toolbar">
        <nav class="tab-nav">
            <button class="active" data-tab="overview" onclick="showTab('overview')">Overview</button>
            <button data-tab="todos" onclick="showTab('todos')">TODOs</button>
            <button data-tab="notes" onclick="showTab('notes')">Notes</button>
        </nav>
        <div class="toolbar-actions">
            <button id="sidebarOpenBtn" class="sidebar-open-btn" onclick="setSidebarOpen(true)" title="Show file browser">&#9776; Files</button>
            <div id="fontMenu" class="font-menu">
                <button id="fontToggle" class="theme-toggle" type="button" onclick="toggleFontMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick reading font">
                    <span class="theme-toggle-kicker">Font</span>
                    <span id="fontToggleLabel" class="theme-toggle-label">Reader</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="fontMenuList" class="font-menu-list" role="listbox" aria-label="Reading font">
                    <li class="font-menu-item" role="option" data-font-value="reader" onmouseenter="previewFont('reader')" onclick="selectFont('reader')">Reader</li>
                    <li class="font-menu-item" role="option" data-font-value="literary" onmouseenter="previewFont('literary')" onclick="selectFont('literary')">Literary</li>
                    <li class="font-menu-item" role="option" data-font-value="inter" onmouseenter="previewFont('inter')" onclick="selectFont('inter')">Inter</li>
                    <li class="font-menu-item" role="option" data-font-value="georgia" onmouseenter="previewFont('georgia')" onclick="selectFont('georgia')">Georgia</li>
                    <li class="font-menu-item" role="option" data-font-value="baskerville" onmouseenter="previewFont('baskerville')" onclick="selectFont('baskerville')">Baskerville</li>
                    <li class="font-menu-item" role="option" data-font-value="sans" onmouseenter="previewFont('sans')" onclick="selectFont('sans')">Sans</li>
                    <li class="font-menu-item" role="option" data-font-value="mono" onmouseenter="previewFont('mono')" onclick="selectFont('mono')">Mono</li>
                </ul>
            </div>
            <div id="themeMenu" class="theme-menu">
                <button id="themeToggle" class="theme-toggle" type="button" onclick="toggleThemeMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick color theme">
                    <span class="theme-toggle-kicker">Theme</span>
                    <span id="themeToggleLabel" class="theme-toggle-label">Light</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="themeMenuList" class="theme-menu-list" role="listbox" aria-label="Color theme">
                    <li class="theme-menu-item" role="option" data-theme-value="light" onmouseenter="previewTheme('light')" onclick="selectTheme('light')">Light</li>
                    <li class="theme-menu-item" role="option" data-theme-value="dark" onmouseenter="previewTheme('dark')" onclick="selectTheme('dark')">Dark</li>
                    <li class="theme-menu-item" role="option" data-theme-value="docsify" onmouseenter="previewTheme('docsify')" onclick="selectTheme('docsify')">Docsify</li>
                    <li class="theme-menu-item" role="option" data-theme-value="hopscotch" onmouseenter="previewTheme('hopscotch')" onclick="selectTheme('hopscotch')">Hopscotch</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="tab-overview" class="tab-panel active">
        {{ goals_card_wrapper | safe }}
        {{ recent_changes_card | safe }}

        <div class="dashboard-grid">
            <div class="card"><div class="card-header"><span class="card-title">Editorial Alerts</span></div>
                <div class="scroll-panel">
                    {{ alerts_html | safe }}
                </div>
            </div>
            <div class="card"><div class="card-header"><span class="card-title">Book-Wide Lexical Health</span></div>
                <div class="health-section"><div>Local Variety (MATTR): <strong>{{ lexical_mattr_text }}</strong></div><div class="range-bar"><div class="target-zone" style="left:{{ lexical_mattr_zone_left }}%; width:{{ lexical_mattr_zone_width }}%;"></div><div class="current-marker" style="left:{{ lexical_mattr_marker_left }}%;"></div></div></div>
                <div class="health-section"><div>Whole-Scene Variety (MTLD): <strong>{{ lexical_mtld_text }}</strong></div><div class="range-bar"><div class="target-zone" style="left:{{ lexical_mtld_zone_left }}%; width:{{ lexical_mtld_zone_width }}%;"></div><div class="current-marker" style="left:{{ lexical_mtld_marker_left }}%;"></div></div></div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="card"><div class="card-header"><span class="card-title">Character Presence Timeline</span></div><div class="chart-frame"><canvas id="presenceChart"></canvas></div></div>
            <div class="card"><div class="card-header"><span class="card-title">Rhythm &amp; Pacing (Sentence length variety)</span></div>
                <div class="section-note">
                    Measures the "pulse" of your prose.
                    <br>&bull; <b>Static (0-4):</b> Monotonous drone.
                    <br>&bull; <b>Rhythmic (5-12):</b> Healthy pulse. <b>Your current target.</b>
                    <br>&bull; <b>Dynamic (13+):</b> High contrast/tension.
                </div>
                <div class="chart-frame"><canvas id="rhythmChart"></canvas></div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="card"><div class="card-header"><span class="card-title">Setting Stickiness (Words per Location)</span></div><div class="chart-frame"><canvas id="locationChart"></canvas></div></div>
            <div class="card"><div class="card-header"><span class="card-title">Character Co-Occurrence</span></div><div class="chart-frame"><canvas id="coOccurChart"></canvas></div></div>
        </div>

        <div class="stats-layout">
            <div class="card" style="padding:0; overflow:hidden;"><div class="card-header" style="margin:20px 24px;"><span class="card-title">Scene Deep Dive</span>
                <select id="issueFilter" class="issue-filter" onchange="applyIssueFilter()">
                    <option value="all">All Scenes</option><option value="repetition">Repetitive</option><option value="clipped">Clipped</option><option value="talky">Talky</option><option value="dense">Dense</option><option value="todos">Has TODOs</option><option value="notes">Has Notes</option><option disabled>──────────</option><option value="status-draft">Status: Draft</option><option value="status-revision">Status: Revision</option><option value="status-done">Status: Done</option><option value="status-unknown">Status: Unknown</option>
                </select></div>
                <table id="sceneTable"><thead><tr><th onclick="sortTable(0)">Scene</th><th onclick="sortTable(1)">Chapter</th><th onclick="sortTable(2)">Words</th><th onclick="sortTable(3)">Variety</th><th onclick="sortTable(4)">Flavor</th><th onclick="sortTable(5)">Top Repeat</th><th onclick="sortTable(6)">Dlg%</th><th onclick="sortTable(7)">Sent</th></tr></thead><tbody>
                    {{ table_body | safe }}
                </tbody></table></div>
            <div class="sticky-sidebar"><div class="card"><div class="card-header"><span class="card-title">Lexical Health Map</span></div><div class="chart-frame-lg"><canvas id="lexicalScatterChart"></canvas></div></div></div>
        </div>
    </div>

    <div id="tab-todos" class="tab-panel">
        <div id="todosTabContent"></div>
    </div>

    <div id="tab-notes" class="tab-panel">
        <div class="notes-toolbar">
            <select id="notesTagFilter" class="notes-filter" onchange="filterNotes()">
                <option value="all">All Tags</option>
                <option value="note">Note</option>
                <option value="continuity">Continuity</option>
                <option value="character">Character</option>
                <option value="theme">Theme</option>
                <option value="question">Question</option>
            </select>
        </div>
