<!DOCTYPE html>
<html lang="en" data-theme="graphite-light"{% if static_snapshot %} data-static-snapshot="{{ static_snapshot }}"{% endif %}{% if manuscript_missing %} data-manuscript="missing"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ snapshot_meta.title if snapshot_meta else 'Manuscript Dashboard' }}</title>
    {% if snapshot_meta %}<meta name="description" content="{{ snapshot_meta.description }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ snapshot_meta.title }}">
    <meta property="og:description" content="{{ snapshot_meta.description }}">
    {% if snapshot_meta.url %}<meta property="og:url" content="{{ snapshot_meta.url }}">
    {% endif %}{% if snapshot_meta.image %}<meta property="og:image" content="{{ snapshot_meta.image }}">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}{% endif %}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23cb4c48%22/%3E%3Cpath d=%22M5.5 14.2c3.4-1.1 6.8-.6 10 1.6v10.4c-3.2-2.1-6.6-2.6-10-1.6z%22 fill=%22%23fff%22/%3E%3Cpath d=%22M26.5 14.2c-3.4-1.1-6.8-.6-10 1.6v10.4c3.2-2.1 6.6-2.6 10-1.6z%22 fill=%22%23fff%22 fill-opacity=%22.86%22/%3E%3Cpath d=%22M14.5 9.2c1.3-1.5 2.9-1.6 4.3-.2 1.4-1.9 3.4-2.4 5.4-1.4%22 fill=%22none%22 stroke=%22%23fff%22 stroke-width=%221.7%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E">
    <script id="proseview-bootstrap">
        (function() {
            const storedKey = 'proseview-theme';
            let theme = 'graphite-light';
            try {
                // Must stay in step with THEME_ORDER and DEFAULT_THEME in
                // 00-state.js. This runs before any other script so the theme
                // is set before first paint, so it cannot read them directly --
                // a value missing here is silently rejected on load and the
                // reader's choice resets to the default. test_themes.py guards
                // both.
                const allowed = ['light', 'dark', 'docsify', 'hopscotch',
                                 'graphite-light', 'graphite-dark'];
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) theme = stored;
            } catch (err) {
                theme = 'graphite-light';
            }
            document.documentElement.dataset.theme = theme;
        })();
        (function() {
            const storedKey = 'proseview-font';
            // Must stay in step with FONT_ORDER in 00-state.js and the
            // #modalFontSelect options below. This runs before any other
            // script so the font is set before first paint, so it cannot read
            // FONT_ORDER directly -- a value missing here is silently rejected
            // on load and the reader's choice resets to 'reader'.
            const allowed = ['reader', 'literary', 'inter', 'georgia', 'baskerville', 'sans', 'mono'];
            let font = 'reader';
            try {
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) font = stored;
            } catch (err) {
                font = 'reader';
            }
            document.documentElement.dataset.font = font;
        })();
        (function() {
            // Open by default, except on a phone, where the file list would
            // take over half the screen. Either way an explicit choice wins.
            try {
                const stored = localStorage.getItem('proseview-sidebar');
                const phone = window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
                if (stored === 'closed' || (stored !== 'open' && phone)) {
                    document.documentElement.dataset.sidebar = 'closed';
                }
            } catch (err) {
                // Ignore storage errors and keep the default open state.
            }
        })();
        // The privacy screen's tab icon: a plain grid. A covered screen stays
        // covered across a reload -- the server marks the page, or with no
        // server this browser remembers it (03-privacy.js) -- so the tab
        // says Budget before anything else shows.
        window.PROSEVIEW_PRIVACY_ICON = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect x=%223%22 y=%224%22 width=%2226%22 height=%2224%22 rx=%222%22 fill=%22%23fff%22 stroke=%22%23707070%22 stroke-width=%222%22/%3E%3Cpath d=%22M3 12h26M3 20h26M12 4v24M20 4v24%22 stroke=%22%23707070%22 stroke-width=%221.6%22/%3E%3C/svg%3E';
        (function() {
            try {
                if (localStorage.getItem('proseview-privacy:' + location.pathname) === 'covered') {
                    document.documentElement.dataset.privacy = 'locked';
                }
            } catch (err) {
                // No storage: only the server can keep the page covered.
            }
            if (document.documentElement.dataset.privacy !== 'locked') return;
            const icon = document.querySelector('link[rel="icon"]');
            window.PROSEVIEW_PRIVACY_SAVED = {title: document.title, icon: icon ? icon.getAttribute('href') : ''};
            document.title = 'Budget';
            if (icon) icon.setAttribute('href', window.PROSEVIEW_PRIVACY_ICON);
        })();
    </script>
    {% if not static_snapshot %}
    {#- Lets Chrome and Edge install the dashboard as its own app (proseview/templates/app). #}
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="apple-touch-icon" href="app-icon-192.png">
    <meta name="theme-color" content="#f4f5f5">
    <script>
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {});
        // The installed app's title bar takes this colour; keep it on the
        // page background of whichever theme is showing.
        document.addEventListener('DOMContentLoaded', () => {
            const root = document.documentElement;
            const meta = document.querySelector('meta[name="theme-color"]');
            const sync = () => {
                const bg = getComputedStyle(root).getPropertyValue('--bg-app').trim();
                if (bg) meta.setAttribute('content', bg);
            };
            sync();
            new MutationObserver(sync).observe(root, {attributes: true, attributeFilter: ['data-theme']});
        });
    </script>
    {% endif %}
    <script src="vendor/chart.js"></script>
    <script src="vendor/chartjs-plugin-annotation.js"></script>
    <script src="vendor/marked.js"></script>
    <style id="proseview-app-css">
{{ app_css | safe }}
    </style>
    {#- Checked hex colours and type names only (proseview/callouts.py). #}
    <style id="proseview-callout-colours">
{{ callout_css | safe }}
    </style>
</head>
<body>
    {#- The privacy screen (Cmd+J J): a dull, unbranded household budget.
        Plain numbers, nothing to read; 03-privacy.js shows it. #}
    {%- set budget_months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] %}
    {%- set budget_rows = [
        ('Rent', [1450, 1450, 1450, 1450, 1450, 1450]),
        ('Electricity', [92.40, 88.15, 76.35, 64.20, 58.90, 71.60]),
        ('Water', [38.00, 38.00, 41.25, 41.25, 44.10, 44.10]),
        ('Gas', [61.80, 57.30, 43.90, 31.15, 22.40, 18.75]),
        ('Internet', [55.00, 55.00, 55.00, 55.00, 55.00, 55.00]),
        ('Phone', [32.50, 32.50, 32.50, 34.00, 34.00, 34.00]),
        ('Groceries', [412.18, 389.40, 431.05, 402.77, 418.30, 396.92]),
        ('Household', [48.20, 23.75, 61.10, 17.40, 35.85, 29.60]),
        ('Transport', [96.00, 96.00, 102.40, 96.00, 118.25, 96.00]),
        ('Insurance', [74.30, 74.30, 74.30, 74.30, 74.30, 74.30]),
        ('Subscriptions', [21.97, 21.97, 21.97, 24.97, 24.97, 24.97]),
        ('Medical', [0, 35.00, 0, 12.50, 0, 60.00]),
        ('Clothing', [0, 64.99, 0, 0, 88.40, 0]),
        ('Gifts', [0, 45.00, 0, 30.00, 0, 52.00]),
        ('Savings', [300, 300, 300, 300, 300, 300]),
    ] %}
    <dialog id="privacyScreen" class="privacy-screen" aria-label="Budget" closedby="none" tabindex="-1">
        <div class="privacy-bar"><span class="privacy-cell-ref">A1</span><span class="privacy-file">Budget</span><input type="password" id="privacyPassword" class="privacy-password" autocomplete="off" spellcheck="false" aria-label="Password" hidden></div>
        <div class="privacy-sheet"><table class="privacy-grid">
            <thead><tr><th></th>{% for col in 'ABCDEFGHIJ' %}<th>{{ col }}</th>{% endfor %}</tr></thead>
            <tbody>
                <tr><th>1</th><td>Item</td>{% for m in budget_months %}<td class="num">{{ m }}</td>{% endfor %}<td class="num">Total</td><td></td><td></td></tr>
                {%- for item, values in budget_rows %}
                <tr><th>{{ loop.index + 1 }}</th><td>{{ item }}</td>{% for v in values %}<td class="num">{{ '{:,.2f}'.format(v) }}</td>{% endfor %}<td class="num">{{ '{:,.2f}'.format(values | sum) }}</td><td></td><td></td></tr>
                {%- endfor %}
                <tr><th>{{ budget_rows | length + 2 }}</th>{% for _ in range(10) %}<td></td>{% endfor %}</tr>
                <tr><th>{{ budget_rows | length + 3 }}</th><td>Total</td>{% for i in range(6) %}<td class="num">{{ '{:,.2f}'.format(budget_rows | map(attribute=1) | map(attribute=i) | sum) }}</td>{% endfor %}<td class="num">{{ '{:,.2f}'.format(budget_rows | map(attribute=1) | map('sum') | sum) }}</td><td></td><td></td></tr>
                {%- for n in range(budget_rows | length + 4, 61) %}
                <tr><th>{{ n }}</th>{% for _ in range(10) %}<td></td>{% endfor %}</tr>
                {%- endfor %}
            </tbody>
        </table></div>
    </dialog>
    {% if static_snapshot %}<p class="static-snapshot-note" role="note">{% if static_snapshot == "demo" %}Demo: edits stay in this tab and are never uploaded. {% else %}Read-only snapshot. {% endif %}Made with <a href="https://github.com/ourarash/proseview" target="_blank" rel="noopener">Proseview</a></p>{% endif %}
    <nav id="repoSidebar" class="repo-sidebar" aria-label="Repository files">
        <div class="sidebar-header">
            <span class="sidebar-title">Files</span>
            <div class="sidebar-header-actions">
                <div class="sidebar-create-wrap"><button id="sidebarCreateBtn" class="sidebar-chrome-btn" type="button" aria-label="Create a file or folder" aria-haspopup="menu" aria-controls="sidebarCreateMenu" aria-expanded="false" title="Create a file or folder">+</button><div id="sidebarCreateMenu" class="sidebar-action-menu sidebar-create-menu" role="menu" hidden><button type="button" role="menuitem" data-create-kind="file">New file</button><button type="button" role="menuitem" data-create-kind="folder">New folder</button></div></div>
                <button class="sidebar-close-btn" type="button" onclick="setSidebarOpen(false)" title="Close sidebar" aria-label="Close sidebar"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7l10 10M17 7L7 17"></path></svg></button>
            </div>
        </div>
        <div id="sidebarTree" class="repo-tree sidebar-tree"></div>
        <div class="sidebar-resize-handle" id="sidebarResizeHandle" role="separator" tabindex="0" aria-label="Resize file browser" aria-orientation="vertical" aria-valuemin="160" aria-valuemax="520" aria-valuenow="280"></div>
    </nav>
    <div id="sidebarContextMenu" class="sidebar-action-menu sidebar-context-menu" role="menu" hidden></div>
    <dialog id="sidebarCreateDialog" class="sidebar-file-dialog" aria-labelledby="sidebarCreateTitle">
        <form id="sidebarCreateForm" method="dialog">
            <h2 id="sidebarCreateTitle">New file</h2>
            <label for="sidebarCreateName">Name</label>
            <input id="sidebarCreateName" name="name" type="text" maxlength="240" autocomplete="off" required>
            <label for="sidebarCreateLocation">Location</label>
            <select id="sidebarCreateLocation" name="parent"></select>
            <p id="sidebarCreatePreview" class="sidebar-dialog-preview"></p>
            <p id="sidebarCreateError" class="sidebar-dialog-error" role="alert" hidden></p>
            <div class="sidebar-dialog-actions"><button type="button" data-dialog-cancel>Cancel</button><button id="sidebarCreateConfirm" class="sidebar-dialog-primary" type="submit">Create</button></div>
        </form>
    </dialog>
    <dialog id="sidebarDeleteDialog" class="sidebar-file-dialog" aria-labelledby="sidebarDeleteTitle" aria-describedby="sidebarDeleteDescription">
        <form id="sidebarDeleteForm" method="dialog">
            <h2 id="sidebarDeleteTitle">Delete file?</h2>
            <p id="sidebarDeleteDescription"></p>
            <p class="sidebar-dialog-note">It will be moved to <code>.proseview/trash</code>, not permanently erased.</p>
            <p id="sidebarDeleteError" class="sidebar-dialog-error" role="alert" hidden></p>
            <div class="sidebar-dialog-actions"><button type="button" data-dialog-cancel>Cancel</button><button id="sidebarDeleteConfirm" class="sidebar-dialog-danger" type="submit">Delete</button></div>
        </form>
    </dialog>
    <dialog id="exportDialog" class="export-dialog" aria-labelledby="exportDialogTitle" aria-describedby="exportStepHint">
        <div class="export-shell">
            <header class="export-header">
                <div class="export-heading">
                    <h2 id="exportDialogTitle">Export</h2>
                    <p id="exportStepHint" class="export-step-hint">Choose what goes into the e-book.</p>
                </div>
                <ol class="export-steps" aria-label="Export steps">
                    <li><button type="button" data-export-step="1" aria-current="step"><span class="export-step-num" aria-hidden="true">1</span>What to export</button></li>
                    <li><button type="button" data-export-step="2"><span class="export-step-num" aria-hidden="true">2</span>Format and style</button></li>
                    <li><button type="button" data-export-step="3"><span class="export-step-num" aria-hidden="true">3</span>Book details</button></li>
                </ol>
                <button type="button" class="export-close" data-export-close aria-label="Close export">&times;</button>
            </header>

            <section id="exportStep1" class="export-body export-what" data-export-panel="1" aria-label="What to export">
                <div class="export-picks" role="group" aria-label="Quick picks">
                    <span class="export-label">Quick picks</span>
                    <div id="exportQuickPicks" class="export-chip-row"></div>
                    <div id="exportPickBy" class="export-pick-by" role="group" aria-labelledby="exportPickByLabel">
                        <span id="exportPickByLabel" class="export-pick-label">Or tick scenes by</span>
                        <label class="sr-only" for="exportPickField">What to pick by</label>
                        <select id="exportPickField" class="export-select export-select-sm"></select>
                        <label class="sr-only" for="exportPickValue">Which</label>
                        <select id="exportPickValue" class="export-select export-select-sm"></select>
                        <label class="sr-only" for="exportPickDate">Changed since</label>
                        <input id="exportPickDate" class="export-select export-select-sm" type="date" hidden>
                        <button type="button" id="exportPickApply" class="export-btn">Tick these</button>
                    </div>
                </div>
                <div class="export-list-tools">
                    <span id="exportListLabel" class="export-label">Chapters and scenes</span>
                    <div class="export-list-actions">
                        <button type="button" id="exportExpandAll" class="export-link-btn">Show all scenes</button>
                        <label class="export-switch"><input type="checkbox" id="exportReorder" role="switch"><span class="export-switch-track" aria-hidden="true"></span>Reorder</label>
                    </div>
                </div>
                <p id="exportReorderNote" class="export-note" hidden>Drag items, or use the arrow buttons, to set the order of the book. Turn Reorder off to change what is included.</p>
                <ul id="exportTree" class="export-tree" aria-label="Chapters and scenes"></ul>
                <ol id="exportOrder" class="export-order" aria-label="Order of the exported book" hidden></ol>
                <div class="export-save-row">
                    <button type="button" id="exportSaveToggle" class="export-link-btn" aria-expanded="false" aria-controls="exportSaveForm">Save this selection…</button>
                    <form id="exportSaveForm" class="export-save-form" hidden>
                        <label for="exportSaveName">Name</label>
                        <input id="exportSaveName" type="text" maxlength="80" placeholder="Beta readers, part one" autocomplete="off" required>
                        <button type="submit" class="export-btn">Save</button>
                        <button type="button" class="export-btn export-btn-quiet" data-export-save-cancel>Cancel</button>
                    </form>
                </div>
            </section>

            <section id="exportStep2" class="export-body export-style" data-export-panel="2" aria-label="Format and style" hidden>
                <fieldset class="export-fieldset">
                    <legend class="export-label">Format</legend>
                    <div id="exportFormatCards" class="export-format-cards"></div>
                </fieldset>
                <div class="export-format-options">
                    <div id="exportPrintOptions" class="export-option-group" hidden>
                        <label for="exportTrim"><strong>Trim size</strong><span class="export-hint">The size of the printed page. 5.5 × 8.5 in is the most common for novels.</span></label>
                        <select id="exportTrim" class="export-select"></select>
                        <label class="export-toggle-row" for="exportRecto">
                            <input type="checkbox" id="exportRecto" role="switch"><span class="export-switch-track" aria-hidden="true"></span>
                            <span><strong>Start chapters on a right-hand page</strong><span class="export-hint">As most printed novels do; it can leave a blank page before a chapter.</span></span>
                        </label>
                    </div>
                    <div id="exportShareOptions" class="export-option-group" hidden>
                        <label for="exportPaper"><strong>Page size</strong></label>
                        <select id="exportPaper" class="export-select"></select>
                        <label for="exportWatermark"><strong>Watermark</strong> <span class="export-optional">optional</span><span class="export-hint">Faint text across every page, to discourage forwarding. Not remembered.</span></label>
                        <input id="exportWatermark" type="text" maxlength="120" placeholder="Advance copy for Sam" autocomplete="off">
                    </div>
                    <fieldset id="exportEpubOptions" class="export-fieldset export-option-group">
                        <legend class="export-label-plain"><strong>E-book version</strong></legend>
                        <label class="export-radio-row"><input type="radio" name="exportEpubVersion" value="epub3" checked><span><strong>EPUB 3</strong> (recommended)<span class="export-hint">What Apple Books, Kobo and Kindle Direct Publishing expect.</span></span></label>
                        <label class="export-radio-row"><input type="radio" name="exportEpubVersion" value="epub2"><span><strong>EPUB 2</strong><span class="export-hint">Only for older e-readers that cannot open EPUB 3.</span></span></label>
                    </fieldset>
                </div>
                <fieldset class="export-fieldset">
                    <legend class="export-label">Book style</legend>
                    <div id="exportStyleCards" class="export-style-cards"></div>
                </fieldset>
                <label class="export-toggle-row" for="exportSceneTitles">
                    <input type="checkbox" id="exportSceneTitles" role="switch"><span class="export-switch-track" aria-hidden="true"></span>
                    <span><strong>Show scene titles</strong><span class="export-hint">Off, scenes are separated by a centred * * *, as in most novels. On, each scene starts with its title and the contents lists it.</span></span>
                </label>
            </section>

            <section id="exportStep3" class="export-body export-details" data-export-panel="3" aria-label="Book details" hidden>
                <div class="export-fields">
                    <label for="exportTitle">Title</label>
                    <input id="exportTitle" type="text" maxlength="300" autocomplete="off">
                    <label for="exportSubtitle">Subtitle <span class="export-optional">optional</span></label>
                    <input id="exportSubtitle" type="text" maxlength="300" autocomplete="off">
                    <label for="exportAuthor">Author</label>
                    <input id="exportAuthor" type="text" maxlength="300" autocomplete="name" placeholder="Your name as readers will see it">
                    <div id="exportContactGroup" class="export-contact" hidden>
                        <label for="exportContact">Contact details <span class="export-optional">for the manuscript’s title page</span></label>
                        <textarea id="exportContact" rows="3" maxlength="600" placeholder="you@example.com&#10;+1 555 0100" autocomplete="off"></textarea>
                    </div>
                    <span class="export-label" id="exportCoverLabel">Cover</span>
                    <div id="exportCoverDrop" class="export-cover-drop" aria-labelledby="exportCoverLabel">
                        <img id="exportCoverImg" class="export-cover-thumb" alt="" hidden>
                        <div class="export-cover-copy">
                            <p id="exportCoverStatus">Drop an image here, or choose one.</p>
                            <p id="exportCoverHint" class="export-hint">JPEG or PNG, at least 1600 × 2560 px for stores.</p>
                            <div class="export-cover-actions">
                                <button type="button" id="exportCoverChoose" class="export-btn">Choose image…</button>
                                <button type="button" id="exportCoverRemove" class="export-btn export-btn-quiet" hidden>Remove</button>
                            </div>
                        </div>
                        <input id="exportCoverInput" type="file" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
                    </div>
                    <details id="exportMatter" class="export-matter">
                        <summary>Front and back matter</summary>
                        <div class="export-matter-body">
                        <p class="export-hint">Pages before and after the story, for the whole book and for selections of chapters. A single chapter or scene goes without them.</p>
                        <label class="export-toggle-row" for="exportCopyright">
                            <input type="checkbox" id="exportCopyright" role="switch"><span class="export-switch-track" aria-hidden="true"></span>
                            <span><strong>Copyright page</strong><span class="export-hint">“Copyright © year, your name. All rights reserved.”</span></span>
                        </label>
                        <label for="exportIsbn">ISBN <span class="export-optional">optional, printed on the copyright page</span></label>
                        <input id="exportIsbn" type="text" maxlength="40" autocomplete="off">
                        <label for="exportDedication">Dedication <span class="export-optional">optional</span></label>
                        <textarea id="exportDedication" rows="2" maxlength="1000" placeholder="For Alice"></textarea>
                        <label for="exportAlsoBy">Your other books <span class="export-optional">one title per line, for an “Also by” page</span></label>
                        <textarea id="exportAlsoBy" rows="3" maxlength="2000"></textarea>
                        <label class="export-toggle-row" for="exportMatterFiles">
                            <input type="checkbox" id="exportMatterFiles" role="switch"><span class="export-switch-track" aria-hidden="true"></span>
                            <span><strong>Your own pages</strong><span id="exportMatterFilesHint" class="export-hint"></span></span>
                        </label>
                        </div>
                    </details>
                    <p id="exportDetailsError" class="export-error" role="alert" hidden></p>
                </div>
                <div class="export-preview" aria-label="Preview">
                    <div class="export-preview-nav">
                        <label class="sr-only" for="exportPreviewFormat">Preview</label>
                        <select id="exportPreviewFormat" class="export-page-pick export-preview-format" hidden></select>
                        <button type="button" id="exportPrevPage" class="export-icon-btn" aria-label="Previous page">&#8249;</button>
                        <label class="sr-only" for="exportPagePick">Go to</label>
                        <select id="exportPagePick" class="export-page-pick"></select>
                        <button type="button" id="exportNextPage" class="export-icon-btn" aria-label="Next page">&#8250;</button>
                    </div>
                    <div class="export-reader"><iframe id="exportPreviewFrame" title="Preview of the e-book" sandbox="allow-same-origin" tabindex="-1"></iframe></div>
                    <div id="exportPaperView" class="export-paper-view" role="img" aria-label="Preview of the PDF pages" hidden></div>
                    <p id="exportPreviewStatus" class="export-preview-status" aria-live="polite"></p>
                </div>
            </section>

            <section id="exportStepRun" class="export-body export-run" data-export-panel="run" aria-label="Exporting" hidden>
                <div class="export-run-box">
                    <p id="exportRunTitle" class="export-run-title">Making your e-book</p>
                    <div id="exportProgress" class="export-progress" role="progressbar" aria-label="Export progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
                    <p id="exportRunStep" class="export-run-step" aria-live="polite">Starting</p>
                </div>
            </section>

            <section id="exportStepDone" class="export-body export-done" data-export-panel="done" aria-label="Finished" hidden>
                <div id="exportDoneBox" class="export-done-box" tabindex="-1"></div>
            </section>

            <p id="exportDemoNote" class="export-demo-note" hidden>This is the online demo: previews and downloads are always the whole book, in the format and style you choose. On your own computer, Proseview builds exactly what you pick.</p>
            <footer class="export-footer">
                <p id="exportTotals" class="export-totals" aria-live="polite"></p>
                <div class="export-actions">
                    <button type="button" id="exportBack" class="export-btn">Back</button>
                    <button type="button" id="exportNext" class="export-btn export-btn-primary">Next</button>
                </div>
            </footer>
        </div>
    </dialog>
    <div id="sidebarFileToast" class="sidebar-file-toast" role="status" aria-live="polite" hidden></div>

    <main id="mainContent">
    <header class="top-banner">
        <div class="dashboard-identity"><svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8"/><path d="M5.5 14.2c3.4-1.1 6.8-.6 10 1.6v10.4c-3.2-2.1-6.6-2.6-10-1.6z" fill="#fff"/><path d="M26.5 14.2c-3.4-1.1-6.8-.6-10 1.6v10.4c3.2-2.1 6.6-2.6 10-1.6z" fill="#fff" fill-opacity=".86"/><path d="M14.5 9.2c1.3-1.5 2.9-1.6 4.3-.2 1.4-1.9 3.4-2.4 5.4-1.4" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><h1>Proseview</h1></div>
        <div class="app-toolbar">
        <nav class="tab-nav" aria-label="Dashboard sections">
            <button class="active" data-tab="overview" aria-current="page" onclick="showTab('overview')">Overview</button>
            <button data-tab="analysis" onclick="showTab('analysis')">Analysis</button>
            <button data-tab="timeline" onclick="showTab('timeline')">Timeline</button>
            <button data-tab="tasks" onclick="showTab('tasks')">Tasks</button>
        </nav>
        <div class="toolbar-actions">
            <button id="sidebarOpenBtn" class="sidebar-open-btn" onclick="setSidebarOpen(true)" title="Show the files of your book" aria-label="Files"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path></svg><span>Files</span></button>
            <div id="dashboardSearchMount" class="dashboard-search-mount">
                <div id="searchMenu" class="search-menu">
                    <div class="search-palette-header">
                        <div class="search-palette-header-copy"><strong id="searchPaletteTitle">Search repository</strong><span>Esc to close</span></div>
                        <button type="button" class="search-palette-close" onclick="_closeSearch()" aria-label="Close search" title="Close search">&times;</button>
                    </div>
                    <label class="sr-only" for="searchBox">Search scenes, files, tasks, and prose</label>
                    <input id="searchBox" class="search-box" type="text" placeholder="Search…" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="searchResults" aria-expanded="false">
                    <div id="searchNavigationWarning" class="search-navigation-warning" role="alert" hidden></div>
                    <div id="searchResults" class="search-results" role="listbox" aria-label="Search results" hidden></div>
                    <div id="searchStatus" class="sr-only" aria-live="polite"></div>
                </div>
            </div>
            <button id="bookOpenBtn" class="theme-toggle book-open-btn" type="button" onclick="openBookView()" aria-label="Read the book" title="Read the whole manuscript from start to finish, as one continuous text"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"></path></svg><span class="theme-toggle-label">Read the book</span></button>
            <button id="exportOpenBtn" class="theme-toggle export-open-btn" type="button" onclick="openExportDialog()" aria-haspopup="dialog" aria-label="Export" title="Export the book as an e-book"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 19h14"></path></svg><span class="theme-toggle-label">Export</span></button>
            <button type="button" id="settingsOpenBtn" class="theme-toggle settings-open-btn" onclick="openSettings()" aria-haspopup="dialog" aria-controls="settingsDialog" aria-label="Settings" title="Settings"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
        </div>
        </div>
    </header>

    {% if manuscript_missing %}
    <section id="manuscriptSetup" class="manuscript-setup" aria-labelledby="manuscriptSetupTitle">
        <h2 id="manuscriptSetupTitle">This folder is open as Markdown files</h2>
        <p>Read, edit and search any file here, and ask Codex or Claude about it. The book features (scene counts, Analysis, Timeline, Goals and Export) need to know where the book is: a manuscript folder of chapter folders, one Markdown file per scene.</p>
        <pre class="manuscript-setup-layout">manuscript/
  ch01/
    01-opening.md
    02-meeting.md
  ch02/
    01-aftermath.md</pre>
        <p class="manuscript-setup-note">No <code>{{ manuscript_path_text }}/</code> folder was found here. Choose the folder that holds the book, or create one.</p>
        <button type="button" id="manuscriptSetupBtn" class="manuscript-setup-btn" onclick="openManuscriptChooser()">Choose manuscript folder…</button>
    </section>
    <dialog id="manuscriptChooser" class="sidebar-file-dialog" aria-labelledby="manuscriptChooserTitle">
        <form method="dialog" onsubmit="event.preventDefault(); saveManuscriptChoice();">
            <h2 id="manuscriptChooserTitle">Where is the book?</h2>
            <p>Each folder inside it is a chapter, and each Markdown file in a chapter is a scene. This is saved as <code>manuscript_path</code> in <code>.proseview.yaml</code>.</p>
            <div id="manuscriptChooserOptions" class="manuscript-chooser-options" role="radiogroup" aria-label="Manuscript folder"></div>
            <p id="manuscriptChooserError" class="sidebar-dialog-error" role="alert" hidden></p>
            <div class="sidebar-dialog-actions"><button type="button" value="cancel" onclick="document.getElementById('manuscriptChooser').close()">Cancel</button><button type="submit" class="sidebar-dialog-primary">Use this folder</button></div>
        </form>
    </dialog>
    {% endif %}
    <div id="tab-overview" class="tab-panel active">
        {{ progress_card | safe }}
        {{ recent_changes_card | safe }}
        {% if scene_count == 0 and not manuscript_missing %}
        <section class="card empty-book" aria-labelledby="emptyBookTitle">
            <h2 id="emptyBookTitle" class="card-title">Your book has no scenes yet</h2>
            <p>Each chapter is a folder inside <code>{{ manuscript_path_text }}/</code>, and each scene is a Markdown file in a chapter folder, such as <code>{{ manuscript_path_text }}/ch01/01-opening.md</code>. Open Files to add your first chapter and scene.</p>
            <button type="button" class="primary-button" onclick="setSidebarOpen(true)">Open Files</button>
        </section>
        {% else %}
        <section class="card scene-list-card" aria-labelledby="sceneListTitle">
            <div class="card-header"><h2 id="sceneListTitle" class="card-title">Scenes<span class="info-tip" tabindex="0" role="img" aria-label="Switch between Table view and Cards view (which shows each scene's POV, place, and Goal / Conflict / Outcome from YAML frontmatter). Use the filter to find scenes with TODOs, short stub drafts under 200 words, or scenes missing Goal/Conflict." data-tip="Switch between Table view and Cards view (which shows each scene's POV, place, and Goal / Conflict / Outcome from YAML frontmatter). Use the filter to find scenes with TODOs, short stub drafts under 200 words, or scenes missing Goal/Conflict.">i</span></h2>
            <div class="scene-list-controls">
            <div class="scene-view-switch" role="group" aria-label="Scene list view">
                <button type="button" class="scene-view-btn active" id="sceneViewTableBtn" data-scene-view="table" onclick="setOverviewSceneView('table')" aria-pressed="true" data-tip="Table view: compare word count, dialogue %, sentence length, and status across all scenes.">Table</button>
                <button type="button" class="scene-view-btn" id="sceneViewCardsBtn" data-scene-view="cards" onclick="setOverviewSceneView('cards')" aria-pressed="false" data-tip="Cards view: see each scene's POV, place, and Goal / Conflict / Outcome from YAML frontmatter.">Cards</button>
            </div>
            <label class="sr-only" for="issueFilter">Show</label>
            <select id="issueFilter" class="issue-filter" onchange="applyIssueFilter()" title="Filter scenes by TODOs, notes, short stub drafts (< 200 words), missing Goal/Conflict in frontmatter, or status">
                <option value="all">All scenes</option><option value="todos">With TODOs</option><option value="notes">With notes</option><option value="stubs" title="Scenes with fewer than 200 words of prose that still need drafting">Short drafts / stubs (&lt; 200 words)</option><option value="missing-beats" title="Scenes without goal: or conflict: set in their YAML frontmatter">Missing Goal or Conflict in frontmatter</option><option disabled>──────</option><option value="status-draft">Draft</option><option value="status-revision">In revision</option><option value="status-done">Done</option><option value="status-unknown">No status</option>
            </select></div></div>
            <table id="sceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortTable(1)" aria-label="Sort by Words">Words</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortTable(2)" aria-label="Sort by Running total" title="Words in the book up to and including this row.">Running total</button></th></tr></thead><tbody>
                {{ table_body | safe }}
            </tbody></table>
            <div id="sceneCardsGrid" class="scene-cards-grid" hidden></div></section>

        {% endif %}
    </div>

    <div id="tab-analysis" class="tab-panel">
        <p id="analysisStatus" class="section-note" role="status" aria-live="polite">Preparing the analysis…</p>
        <div id="analysisContent" hidden>
            <section class="card analysis-findings" aria-labelledby="findingsTitle"><h2 id="findingsTitle" class="card-title">What stands out</h2><ul id="analysisFindings" class="findings-list"></ul></section>
            <div class="dashboard-grid">
                <figure class="card chart-figure" aria-labelledby="presenceChartTitle"><div class="card-header"><h2 class="card-title" id="presenceChartTitle">Characters by chapter<span class="info-tip" tabindex="0" role="img" aria-label="A character is in a scene when the scene&#x27;s characters: or pov: frontmatter names them. A scene without a characters: list falls back to whether the name appears in its prose. Use it to spot a character who drops out for a stretch." data-tip="A character is in a scene when the scene&#x27;s characters: or pov: frontmatter names them. A scene without a characters: list falls back to whether the name appears in its prose. Use it to spot a character who drops out for a stretch.">i</span></h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">How many scenes in each chapter each character is in.</p></div><div class="chart-frame"><canvas id="presenceChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
                <figure class="card chart-figure" aria-labelledby="locationChartTitle"><div class="card-header"><h2 class="card-title" id="locationChartTitle">Words by place<span class="info-tip" tabindex="0" role="img" aria-label="From each scene&#x27;s where: or location: frontmatter, or its folder when it has neither. Places are matched as written, so two spellings count as two places. The eight largest are shown." data-tip="From each scene&#x27;s where: or location: frontmatter, or its folder when it has neither. Places are matched as written, so two spellings count as two places. The eight largest are shown.">i</span></h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">How many words of the book happen in each place.</p></div><div class="chart-frame"><canvas id="locationChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
            </div>

            <div class="dashboard-grid" style="grid-template-columns: 1fr;">
                <figure class="card chart-figure" aria-labelledby="coOccurChartTitle"><div class="card-header"><h2 class="card-title" id="coOccurChartTitle">Characters who share scenes<span class="info-tip" tabindex="0" role="img" aria-label="Two characters share a scene when both are in it, by the same rule as Character Presence. Shows your strongest pairings, and who never meets." data-tip="Two characters share a scene when both are in it, by the same rule as Character Presence. Shows your strongest pairings, and who never meets.">i</span></h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">How many scenes each pair of characters shares.</p></div><div class="chart-frame"><canvas id="coOccurChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
            </div>

            <div class="stats-layout" style="margin-bottom: 24px;">
                <section class="card"><div class="card-header"><h2 class="card-title">Word variety<span class="info-tip" tabindex="0" role="img" aria-label="How many different words the prose uses. Low variety means the same words keep coming back. Its usual range is set in Settings → Word variety." data-tip="How many different words the prose uses. Low variety means the same words keep coming back. Its usual range is set in Settings → Word variety.">i</span></h2></div>
                    <p class="section-note" style="margin-bottom: 24px; margin-top:0;">Whether the prose keeps finding new words, or keeps coming back to the same ones.</p>

                    <div class="health-section" style="margin-bottom: 24px;">
                        <div style="font-size: 16px; margin-bottom: 4px; font-weight: 500; color: var(--text-primary);">Nearby words: <strong id="analysisMattrText" style="font-weight: 700;"></strong><span class="info-tip" tabindex="0" role="img" aria-label="MATTR, the moving-average type-token ratio: the share of different words in every 100-word window, averaged over the book. Low means words come back close together, as in &quot;He opened the door and walked through the door.&quot;" data-tip="MATTR, the moving-average type-token ratio: the share of different words in every 100-word window, averaged over the book. Low means words come back close together, as in &quot;He opened the door and walked through the door.&quot;">i</span></div>
                        <p class="section-note" style="margin-top: 0; margin-bottom: 12px; line-height: 1.4;">In a typical 100-word stretch, <strong id="analysisMattrExplanationText"></strong> of the words are different words.</p>
                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-muted); font-weight: 500;">
                            <span>Repetitive</span>
                            <div class="range-bar" style="flex: 1;"><div class="target-zone" id="analysisMattrZone"></div><div class="current-marker" id="analysisMattrMarker"></div></div>
                            <span>Varied</span>
                        </div>
                    </div>

                    <div class="health-section">
                        <div style="font-size: 16px; margin-bottom: 4px; font-weight: 500; color: var(--text-primary);">Across a scene: <strong id="analysisMtldText" style="font-weight: 700;"></strong><span class="info-tip" tabindex="0" role="img" aria-label="MTLD, the measure of textual lexical diversity: how long a stretch of text runs, on average, before its share of different words drops to 72%. Higher is richer. A scene of &quot;yes&quot;, &quot;no&quot; and &quot;okay&quot; scores low." data-tip="MTLD, the measure of textual lexical diversity: how long a stretch of text runs, on average, before its share of different words drops to 72%. Higher is richer. A scene of &quot;yes&quot;, &quot;no&quot; and &quot;okay&quot; scores low.">i</span></div>
                        <p class="section-note" style="margin-top: 0; margin-bottom: 12px; line-height: 1.4;">On average the prose runs <strong id="analysisMtldExplanationText"></strong> before its vocabulary starts to repeat.</p>
                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-muted); font-weight: 500;">
                            <span>Limited Vocab</span>
                            <div class="range-bar" style="flex: 1;"><div class="target-zone" id="analysisMtldZone"></div><div class="current-marker" id="analysisMtldMarker"></div></div>
                            <span>Rich Vocab</span>
                        </div>
                        <p class="health-refs" id="analysisMtldRefs"></p>
                    </div>
                </section>

                <figure class="card chart-figure" aria-labelledby="lexicalScatterChartTitle"><div class="card-header"><h2 class="card-title" id="lexicalScatterChartTitle">Word variety by scene<span class="info-tip info-tip-end" tabindex="0" role="img" aria-label="Across: local variety (MATTR). Up: whole-scene variety (MTLD). The shaded area starts at the low end of the usual range in Settings → Word variety; anything above or to the right of that is fine." data-tip="Across: local variety (MATTR). Up: whole-scene variety (MTLD). The shaded area starts at the low end of the usual range in Settings → Word variety; anything above or to the right of that is fine.">i</span></h2></div>
                    <div class="section-note" style="margin-top: 4px; margin-bottom: 12px; line-height: 1.4;">
                        Each dot is a scene. Dots in the shaded area have healthy variety; dots below or left of it repeat words more than is usual for the range in Settings → Word variety.
                    </div>
                    <div class="chart-frame-lg"><canvas id="lexicalScatterChart" aria-hidden="true"></canvas></div><div class="chart-data"></div>
                </figure>
            </div>


            <details id="analysisTableDetails" class="card analysis-table-card">
                <summary><h2 class="card-title">Every scene, measured</h2><span class="section-note">Word variety, keywords, dialogue and sentence length for each scene</span></summary>
                    <div class="analysis-table-tools"><label for="analysisIssueFilter">Show</label>
                    <select id="analysisIssueFilter" class="issue-filter" onchange="applyAnalysisIssueFilter()">
                        <option value="all">All scenes</option><option value="review">Repeats words</option><option value="talky">Mostly dialogue</option><option value="clipped">Short sentences</option><option value="todos">With TODOs</option><option value="notes">With notes</option>
                    </select></div>
                    <table id="analysisSceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(1)" aria-label="Sort by Words">Words</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(2)" aria-label="Sort by Word variety" title="Nearby words (MATTR), then across the scene (MTLD). Amber means under the usual range in Settings → Word variety.">Word variety</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(3)" aria-label="Sort by Keywords" title="The 3 words most particular to this scene, compared to the rest of the book.">Keywords</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(4)" aria-label="Sort by Most repeated" title="The word this scene repeats most.">Most repeated</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(5)" aria-label="Sort by Dialogue" title="Share of the scene inside quotation marks.">Dialogue</button></th><th aria-sort="none" class="num-col"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(6)" aria-label="Sort by Sentence length" title="Average sentence length in words">Sentence length</button></th></tr></thead><tbody id="analysisTableBody"></tbody></table>
            </details>
        </div>
    </div>

    <div id="tab-timeline" class="tab-panel">
        <div id="timelineContent"></div>
    </div>

    <div id="tab-tasks" class="tab-panel">
        <section class="tasks-section" aria-labelledby="todosHeading">
            <h2 id="todosHeading" class="tasks-heading">TODOs</h2>
            <div id="todosTabContent"></div>
        </section>
        <section class="tasks-section" aria-labelledby="notesHeading">
        <div class="notes-toolbar">
            <h2 id="notesHeading" class="tasks-heading">Notes</h2>
            <select id="notesTagFilter" class="notes-filter" onchange="filterNotes()" aria-label="Show notes tagged">
                <option value="all">All Tags</option>
                <option value="note">Note</option>
                <option value="continuity">Continuity</option>
                <option value="character">Character</option>
                <option value="theme">Theme</option>
                <option value="question">Question</option>
            </select>
        </div>
        <div id="notesTabContent"></div>
        </section>
    </div>

    <dialog id="ledgerDialog" class="ledger-dialog" aria-labelledby="ledgerTitle">
        <div class="ledger-head">
            <h2 id="ledgerTitle">What changed</h2>
            <button type="button" class="ledger-close" onclick="this.closest('dialog').close()" aria-label="Close">&times;</button>
        </div>
        <div class="ledger-controls">
            <div class="ledger-source" role="radiogroup" aria-label="Measured from">
                <button type="button" role="radio" data-ledger-source="record" aria-checked="true" title="Copies of your scenes Proseview keeps each day it runs">Proseview's record</button>
                <button type="button" role="radio" data-ledger-source="git" aria-checked="false" title="Your files now against a commit you choose">Git</button>
            </div>
            <label class="sr-only" for="ledgerPeriod">Period</label>
            <select id="ledgerPeriod" class="issue-filter">
                <option value="today">Today</option>
                <option value="yesterday">Yesterday</option>
                <option value="week">Last 7 days</option>
                <option value="month">Last 30 days</option>
            </select>
            <label class="sr-only" for="ledgerCommit">Compare with commit</label>
            <select id="ledgerCommit" class="issue-filter ledger-commit" hidden></select>
        </div>
        <div id="ledgerBody" class="ledger-body" aria-live="polite"></div>
    </dialog>

    <!-- Modals and Overlays -->
    <div id="file-preview-panel">
        <header class="modal-header file-preview-toolbar" data-toolbar-hidden="false"><div class="modal-header-inner">
            <div class="scene-toolbar-leading"><button type="button" class="scene-back-btn scene-toolbar-button" onclick="closeFilePreview()" aria-label="Close file and return to dashboard" title="Return to dashboard"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg><span class="scene-toolbar-button-label">Dashboard</span></button><button id="fileSidebarBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="setSidebarOpen(document.documentElement.dataset.sidebar==='closed')" aria-label="Toggle file browser" aria-keyshortcuts="B" title="Toggle file browser (B)"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path></svg></button></div>
            <div class="file-preview-heading"><h1 id="filePreviewTitle" tabindex="-1"></h1><div id="filePreviewMeta" class="file-preview-meta"></div></div>
            <div class="modal-header-controls">
                <button type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="focusSearch()" aria-label="Search files" aria-keyshortcuts="Meta+K Control+K" title="Search files"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button>
                <button type="button" class="scene-toolbar-button discuss-open-btn" onclick="toggleScenePanel(this)" aria-label="Show or hide the scene panel" title="Show or hide the scene panel"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="15" y1="3" x2="15" y2="21"></line></svg><span class="scene-toolbar-action-label">Panel</span></button>
                <button type="button" id="filePreviewEditBtn" class="scene-toolbar-button" onclick="toggleFileEdit()" aria-keyshortcuts="E" title="Edit this note (E)" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg><span class="scene-toolbar-action-label">Edit</span></button>
                <div class="scene-toolbar-menu-wrap"><button id="fileAppearanceBtn" type="button" class="scene-toolbar-button scene-toolbar-icon-button" onclick="toggleSceneToolbarMenu('fileAppearanceMenu', this)" aria-label="Reading appearance" aria-haspopup="dialog" aria-controls="fileAppearanceMenu" aria-expanded="false" title="Text size, line width, font and theme">Aa</button><section id="fileAppearanceMenu" class="scene-toolbar-popover scene-appearance-menu" role="dialog" aria-label="Reading appearance" hidden>
