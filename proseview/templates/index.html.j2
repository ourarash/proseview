    <script type="module">
        // ProseMirror is vendored under vendor/pm/ and served from this
        // origin. It used to be imported from esm.sh, which cost ~170ms of
        // load time, broke the editor offline, and told a third party every
        // time someone opened their manuscript.
        //
        // The graph was flattened by scripts/vendor_prosemirror.py -- run that
        // to change versions, and commit what it writes. Shared packages are
        // deduplicated to one file each, so Schema identity holds across
        // imports; two copies of prosemirror-model would break instanceof.
        import { Schema, Fragment } from './vendor/pm/prosemirror-model.js';
        import { schema as mdSchema, MarkdownParser, MarkdownSerializer,
                 defaultMarkdownParser, defaultMarkdownSerializer } from './vendor/pm/prosemirror-markdown.js';
        import { EditorState, Plugin, PluginKey, TextSelection } from './vendor/pm/prosemirror-state.js';
        import { EditorView, Decoration, DecorationSet } from './vendor/pm/prosemirror-view.js';
        import { history, undo, redo } from './vendor/pm/prosemirror-history.js';
        import { keymap } from './vendor/pm/prosemirror-keymap.js';
        import { gapCursor, GapCursor } from './vendor/pm/prosemirror-gapcursor.js';
        import { baseKeymap, toggleMark, wrapIn, lift, chainCommands } from './vendor/pm/prosemirror-commands.js';
        import { wrapInList, liftListItem, splitListItem } from './vendor/pm/prosemirror-schema-list.js';
        import { inputRules, wrappingInputRule } from './vendor/pm/prosemirror-inputrules.js';

        // Enable HTML so block-level <!-- TODO/NOTE --> comments are emitted
        // as html_block tokens, which the parser rule in 40-prose-editor.js
        // maps to annotation nodes. The default tokenizer has html:false,
        // which would otherwise pass these through as plain text and the
        // user would see the raw <!-- ... --> in the prose.
        defaultMarkdownParser.tokenizer.set({ html: true });
        // > [!type] Title quotations become callout tokens (14-callouts.js).
        calloutPlugin(defaultMarkdownParser.tokenizer);

        const annotationSpec = {
            attrs: { raw: { default: '' } },
            inline: false, group: 'block',
            atom: true, selectable: false,
            parseDOM: [],
            toDOM(node) {
                const raw = String(node.attrs.raw || '');
                if (!raw.match(/^<!--/)) {
                    const el = document.createElement('div');
                    el.className = 'pm-raw-html';
                    el.contentEditable = 'false';
                    el.innerHTML = raw;
                    return el;
                }
                const inner = raw.replace(/^<!--\s*/, '').replace(/\s*-->$/, '').trim();
                const todoMatch = /^TODO\s*:\s*(.*)$/i.exec(inner);
                const noteMatch = /^NOTE(?:\[(\w+)\])?\s*:\s*(.*)$/i.exec(inner);
                let kind = 'note';
                let tag = 'note';
                let body = inner;
                if (todoMatch) {
                    kind = 'todo';
                    tag = 'todo';
                    body = todoMatch[1];
                } else if (noteMatch) {
                    kind = 'note';
                    tag = (noteMatch[1] || 'note').toLowerCase();
                    body = noteMatch[2];
                }
                const icon = kind === 'todo' ? '📝' : '📌';
                return ['div', {
                    class: 'pm-annotation pm-annotation-' + kind,
                    contenteditable: 'false',
                    'data-tag': tag,
                    title: kind === 'todo' ? '' : body,
                }, ['span', { class: 'pm-annotation-icon' }, icon],
                   ['span', { class: 'pm-annotation-text' }, body]];
            }
        };

        function parseAnnotationRawForView(raw) {
            const text = String(raw || '');
            if (!text.match(/^<!--/)) {
                return { kind: 'html', tag: 'HTML', body: text, icon: '🌐' };
            }
            let m = text.match(/^<!--\s*TODO:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'todo', tag: 'TODO', body: m[1], icon: '📝' };
            m = text.match(/^<!--\s*NOTE\[(\w+)\]:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'note', tag: m[1], body: m[2], icon: '📌' };
            m = text.match(/^<!--\s*NOTE:\s*([\s\S]*?)\s*-->$/);
            if (m) return { kind: 'note', tag: 'NOTE', body: m[1], icon: '📌' };
            return {
                kind: 'todo',
                tag: 'TODO',
                body: text.replace(/^<!--\s*/, '').replace(/\s*-->$/, ''),
                icon: '📝'
            };
        }

        function buildAnnotationRawFromView(tag, text) {
            if (tag === 'HTML') return text;
            if (tag === 'TODO') return '<!-- TODO: ' + text + ' -->';
            if (tag === 'NOTE') return '<!-- NOTE: ' + text + ' -->';
            return '<!-- NOTE[' + tag + ']: ' + text + ' -->';
        }

        class AnnotationNodeView {
            constructor(node, view, getPos, decorations) {
                this.node = node;
                this.lineJump = lineJumpFrom(decorations);
                this.view = view;
                this.getPos = getPos;
                this.editing = false;
                this.autoSave = false;
                this.dom = document.createElement('div');
                this.dom.contentEditable = 'false';
                this.dom._annotationStartEdit = this.startEdit.bind(this);
                this.renderRead();
            }
            parsed() {
                return parseAnnotationRawForView(this.node.attrs.raw);
            }
            setBaseClass(parsed) {
                if (parsed.kind === 'html' && !this.editing) {
                    this.dom.className = 'pm-raw-html';
                    this.dom.dataset.tag = 'html';
                    this.dom.title = '';
                } else {
                    this.dom.className = 'pm-annotation pm-annotation-' + parsed.kind + (this.editing ? ' pm-annotation-editing' : '');
                    this.dom.dataset.tag = parsed.tag.toLowerCase();
                    this.dom.title = this.editing || parsed.kind === 'todo' ? '' : parsed.body;
                }
            }
            renderRead() {
                const parsed = this.parsed();
                this.editing = false;
                this.setBaseClass(parsed);
                this.dom.replaceChildren();
                
                if (parsed.kind === 'html') {
                    this.dom.innerHTML = parsed.body;
                    this.dom.onclick = null;
                    this.dom.ondblclick = (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        this.startEdit(!window._pmEditMode);
                    };
                } else {
                    const icon = document.createElement('span');
                    icon.className = 'pm-annotation-icon';
                    icon.textContent = parsed.icon;
                    const text = document.createElement('span');
                    text.className = 'pm-annotation-text';
                    text.textContent = parsed.body;
                    this.dom.append(icon, text);
                    this.appendLineJump();

                    this.dom.ondblclick = null;
                    this.dom.onclick = (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        this.startEdit(!window._pmEditMode);
                    };
                }
            }
            // The gutter's "open in editor" arrow, as paragraphs get from a
            // widget (see 10-prose-indicators.js).
            appendLineJump() {
                if (!this.lineJump) return;
                const a = document.createElement('a');
                a.className = 'pm-line-jump';
                a.href = this.lineJump.href;
                a.target = '_blank';
                a.rel = 'noopener';
                a.title = this.lineJump.title;
                a.textContent = '↗';
                // Not the box's click, which would open the TODO for editing.
                a.onclick = (event) => event.stopPropagation();
                this.dom.append(a);
            }
            renderEdit() {
                const parsed = this.parsed();
                this.setBaseClass(parsed);
                this.dom.replaceChildren();
                this.dom.onclick = null;

                const icon = document.createElement('span');
                icon.className = 'pm-annotation-icon';
                icon.textContent = parsed.icon;

                const form = document.createElement('div');
                form.className = 'pm-annotation-edit-body';

                const editable = document.createElement('div');
                editable.className = 'pm-annotation-text pm-annotation-edit-text';
                editable.contentEditable = 'plaintext-only';
                editable.role = 'textbox';
                editable.ariaMultiLine = 'true';
                editable.dataset.placeholder = parsed.kind === 'todo' ? 'TODO text' : 'Note text';
                editable.textContent = parsed.body;
                editable.onkeydown = (event) => {
                    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
                        event.preventDefault();
                        event.stopPropagation();
                        this.save(editable.innerText);
                    } else if (event.key === 'Escape') {
                        event.preventDefault();
                        event.stopPropagation();
                        cancel.click();
                    } else if (event.key === 'Enter' && !event.shiftKey) {
                        event.preventDefault();
                        event.stopPropagation();
                        this.save(editable.innerText);
                    }
                };

                const actions = document.createElement('div');
                actions.className = 'pm-annotation-edit-actions';

                const cancel = document.createElement('button');
                cancel.type = 'button';
                cancel.className = 'pm-annotation-cancel';
                cancel.textContent = 'Cancel';
                cancel.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    // A TODO just added from the gutter has nothing to go
                    // back to, so cancelling it takes it out again.
                    if (this.insertedFrom) {
                        const wasDirty = this.insertedFrom.wasDirty;
                        this.deleteNode();
                        if (!wasDirty && typeof window.setPmDirty === 'function') window.setPmDirty(false);
                        return;
                    }
                    const shouldExitEdit = this.autoSave && !window._pmDirty && typeof window.cancelSceneEdit === 'function';
                    this.autoSave = false;
                    this.renderRead();
                    if (shouldExitEdit) window.cancelSceneEdit();
                };

                const resolve = document.createElement('button');
                resolve.type = 'button';
                resolve.className = 'pm-annotation-delete';
                resolve.textContent = parsed.kind === 'todo' ? 'Resolve' : 'Delete';
                resolve.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    this.deleteNode();
                };

                const save = document.createElement('button');
                save.type = 'button';
                save.className = 'pm-annotation-save';
                save.textContent = 'Save';
                save.onclick = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    this.save(editable.innerText);
                };

                if (parsed.kind === 'todo') {
                    const unstickTip = 'Ask Codex or Claude to suggest 3 ways to write or bridge this TODO beat using the paragraphs before and after it.';
                    const unstickEdit = document.createElement('button');
                    unstickEdit.type = 'button';
                    unstickEdit.className = 'pm-annotation-unstick pm-annotation-unstick-edit';
                    unstickEdit.dataset.tip = unstickTip;
                    unstickEdit.textContent = 'Suggest';
                    unstickEdit.onclick = (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        const bodyText = String(editable.innerText || parsed.body || '').trim();
                        this.editing = false;
                        this.autoSave = false;
                        this.renderRead();
                        if (typeof window.openTodoUnstickCard === 'function') {
                            window.openTodoUnstickCard(this.dom, bodyText, this.getPos());
                        }
                    };
                    actions.append(unstickEdit);
                }
                actions.append(cancel, resolve, save);
                form.append(editable, actions);
                this.dom.append(icon, form);


                setTimeout(() => {
                    try { editable.focus({ preventScroll: true }); }
                    catch (err) { editable.focus(); }
                    var sel = window.getSelection && window.getSelection();
                    if (sel) {
                        var range = document.createRange();
                        range.selectNodeContents(editable);
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }
                }, 0);
            }
            startEdit(autoSave, insertedFrom) {
                const scrollEl = document.querySelector('#sceneModal .modal-content');
                const scrollTop = scrollEl ? scrollEl.scrollTop : null;
                if (!window._pmEditMode && typeof window.toggleSceneEdit === 'function') {
                    window.toggleSceneEdit();
                }
                if (scrollEl && scrollTop !== null) scrollEl.scrollTop = scrollTop;
                this.autoSave = !!autoSave;
                this.insertedFrom = insertedFrom || null;
                this.editing = true;
                this.renderEdit();
            }
            save(text) {
                const parsed = this.parsed();
                const raw = buildAnnotationRawFromView(parsed.tag, String(text || '').trim());
                const pos = this.getPos();
                const shouldAutoSave = this.autoSave;
                const shouldFocusEditor = !!(this.insertedFrom && this.insertedFrom.focusEditorAfterSave);
                this.view.dispatch(this.view.state.tr.setNodeMarkup(pos, null, { raw }));
                this.editing = false;
                this.insertedFrom = null;
                this.autoSave = false;
                this.renderRead();
                if (shouldAutoSave && typeof window.saveSceneEdit === 'function') window.saveSceneEdit();
                else if (shouldFocusEditor && this.view) this.view.focus();
            }

            deleteNode() {
                const pos = this.getPos();
                const shouldAutoSave = this.autoSave;
                this.view.dispatch(this.view.state.tr.delete(pos, pos + this.node.nodeSize));
                this.autoSave = false;
                if (shouldAutoSave && typeof window.saveSceneEdit === 'function') window.saveSceneEdit();
            }
            update(node, decorations) {
                if (node.type !== this.node.type) return false;
                this.node = node;
                this.lineJump = lineJumpFrom(decorations);
                if (!this.editing) this.renderRead();
                return true;
            }
            stopEvent() { return true; }
            ignoreMutation() { return true; }
            destroy() {
                delete this.dom._annotationStartEdit;
            }
        }

        function lineJumpFrom(decorations) {
            const deco = (decorations || []).find(d => d.spec && d.spec.lineJump);
            return deco ? deco.spec.lineJump : null;
        }

        function createAnnotationNodeView(node, view, getPos, decorations) {
            return new AnnotationNodeView(node, view, getPos, decorations);
        }

        // A block the note editor shows but does not edit (a table), written
        // back exactly as it was. See 69-file-edit.js.
        const rawBlockSpec = {
            attrs: { raw: { default: '' } },
            group: 'block', atom: true, selectable: false,
            parseDOM: [],
            toDOM() { return ['div', { class: 'pm-raw-block', contenteditable: 'false' }]; }
        };

        const mySchema = new Schema({
            nodes: mdSchema.spec.nodes.addToEnd('annotation', annotationSpec).addToEnd('raw_block', rawBlockSpec)
                .addToEnd('callout', calloutNodeSpec).addToEnd('callout_title', calloutTitleNodeSpec),
            marks: mdSchema.spec.marks
        });

        const hlPluginKey = new PluginKey('highlights');

        function buildHlPlugin() {
            return new Plugin({
                key: hlPluginKey,
                state: {
                    init() { return DecorationSet.empty; },
                    apply(tr, set) {
                        const next = tr.getMeta(hlPluginKey);
                        if (next !== undefined) return next;
                        return set.map(tr.mapping, tr.doc);
                    }
                },
                props: {
                    decorations(state) { return hlPluginKey.getState(state); }
                }
            });
        }

        window._PM = {
            Schema, Fragment, EditorState, EditorView, Plugin, PluginKey, TextSelection,
            Decoration, DecorationSet,
            mySchema, mdSchema,
            MarkdownParser, MarkdownSerializer,
            defaultMarkdownParser, defaultMarkdownSerializer,
            history, undo, redo, keymap, baseKeymap, gapCursor, GapCursor, toggleMark, wrapIn, lift, chainCommands,
            wrapInList, liftListItem, splitListItem, inputRules, wrappingInputRule,
            hlPluginKey, buildHlPlugin, createAnnotationNodeView
        };
        window.dispatchEvent(new Event('proseview:editor-ready'));

        // If the scene view is already open, re-render so it uses ProseMirror.
        if (document.documentElement.dataset.view === 'scene' && typeof render === 'function') {
            render();
        }
    </script>

    <script>
        function makeDraggable(modalId, headerSelector) {
            const overlay = document.getElementById(modalId);
            if (!overlay) return;
            const modal = overlay.querySelector('.diff-modal');
            const header = overlay.querySelector(headerSelector);
            if (!modal || !header) return;
            
            header.style.cursor = 'move';
            
            let isDragging = false;
            let startX, startY, initialLeft, initialTop;
            
            header.addEventListener('mousedown', function(e) {
                // Don't drag if clicking buttons or inputs
                if (e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT' || e.target.tagName === 'LABEL' || e.target.closest('button') || e.target.closest('label')) return;
                
                isDragging = true;
                startX = e.clientX;
                startY = e.clientY;
                
                const rect = modal.getBoundingClientRect();
                initialLeft = rect.left;
                initialTop = rect.top;
                
                // Switch to absolute positioning if not already
                modal.style.position = 'absolute';
                modal.style.left = initialLeft + 'px';
                modal.style.top = initialTop + 'px';
                modal.style.transform = 'none'; // Clear any centering transforms just in case
                modal.style.margin = '0';
                
                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
                
                // Prevent text selection while dragging
                e.preventDefault();
            });
            
            function onMouseMove(e) {
                if (!isDragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                modal.style.left = (initialLeft + dx) + 'px';
                modal.style.top = (initialTop + dy) + 'px';
            }
            
            function onMouseUp() {
                isDragging = false;
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            makeDraggable('discussDiffModalOverlay', '.card-header');
            makeDraggable('diffModalOverlay', '.card-header');
        });
    </script>
    <!-- Modals at the end of body to ensure they overlay everything -->


    <!-- Discuss Diff Modal -->
    <div id="discussDiffModalOverlay" class="modal-overlay" onclick="if(event.target === this) closeDiscussDiffModal()" hidden>
        <div class="diff-modal card" role="dialog" aria-modal="true" aria-labelledby="discussDiffModalTitle">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 class="card-title" id="discussDiffModalTitle">Review Changes</h2>
                    <p class="section-note" id="discussDiffModalNote" style="margin-top: 4px; margin-bottom: 0;">Review the changes the agent made.</p>
                </div>
                <div style="display: flex; gap: 16px; align-items: center;">
                    <label class="scene-toolbar-field" for="discussDiffFontSize" style="margin:0; border:none; padding:0; background:none;">
                        <span style="font-size:13px; color:var(--text-muted);">Aa</span>
                        <input id="discussDiffFontSize" type="range" min="12" max="36" value="18" oninput="updateDiscussDiffFontSize(this.value)" style="width: 80px;">
                    </label>
                    <div class="diff-toggle-group">
                        <button type="button" class="diff-toggle-btn" id="discussDiffToggleInline" onclick="setDiscussDiffMode('inline')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
                            Inline
                        </button>
                        <button type="button" class="diff-toggle-btn active" id="discussDiffToggleSideBySide" onclick="setDiscussDiffMode('side-by-side')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="18" rx="1"></rect><rect x="14" y="3" width="7" height="18" rx="1"></rect></svg>
                            Split
                        </button>
                    </div>
                    <button type="button" class="close-btn" onclick="closeDiscussDiffModal()" aria-label="Close diff viewer">&times;</button>
                </div>
            </div>
            <div id="discussDiffModalContent" class="diff-modal-content">
                <!-- Diff HTML injected here -->
            </div>
            <div class="diff-modal-footer">
                <button type="button" class="editor-btn" onclick="closeDiscussDiffModal()">Close</button>
            </div>
        </div>
    </div>

    <div id="diffModalOverlay" class="modal-overlay" hidden>
        <div class="diff-modal card" role="dialog" aria-modal="true" aria-labelledby="diffModalTitle">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 class="card-title" id="diffModalTitle">Review Changes</h2>
                    <p class="section-note" id="diffModalSubtitle" style="margin-top: 4px; margin-bottom: 0;">Restoring this version will apply the following changes to the current file.</p>
                </div>
                <div style="display: flex; gap: 16px; align-items: center;">
                    <div class="diff-toggle-group">
                        <button type="button" class="diff-toggle-btn active" id="diffToggleInline" onclick="setDiffMode('inline')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
                            Inline
                        </button>
                        <button type="button" class="diff-toggle-btn" id="diffToggleSideBySide" onclick="setDiffMode('side-by-side')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="18" rx="1"></rect><rect x="14" y="3" width="7" height="18" rx="1"></rect></svg>
                            Split
                        </button>
                    </div>
                    <label style="display: flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 13px; cursor: pointer; user-select: none;">
                        <input type="checkbox" id="diffShowFull" onchange="toggleDiffContext()" style="margin: 0; cursor: pointer;">
                        Show entire file
                    </label>
                    <button type="button" class="close-btn" onclick="closeDiffModal()" aria-label="Close diff viewer">&times;</button>
                </div>
            </div>
            <div id="diffModalContent" class="diff-modal-content">
                <!-- Diff HTML injected here -->
            </div>
            <div class="diff-modal-footer">
                <button type="button" class="editor-btn" onclick="closeDiffModal()">Cancel</button>
                <button type="button" class="primary-button" id="diffModalRestoreBtn">Confirm Restore</button>
                <button type="button" class="primary-button" id="diffModalOverwriteBtn" onclick="overwriteDiskWithConflictDraft()" hidden>Overwrite disk version</button>
            </div>
        </div>
    </div>
</body>
