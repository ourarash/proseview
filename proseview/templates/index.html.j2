                    <option value="literary">Literary</option>
                    <option value="inter">Inter</option>
                    <option value="georgia">Georgia</option>
                    <option value="baskerville">Baskerville</option>
                    <option value="sans">Sans</option>
                    <option value="mono">Mono</option>
                </select>
                <select id="filePreviewThemeSelect" class="font-select-inline" onchange="selectTheme(this.value)" title="Color theme">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="docsify">Docsify</option>
                    <option value="hopscotch">Hopscotch</option>
                </select>
                <a id="filePreviewEditorBtn" class="editor-btn" href="#" target="_blank" style="flex-shrink:0;" title=""></a>
                <button type="button" class="editor-btn" id="filePreviewRefreshBtn" onclick="refreshFilePreview()" title="Refresh file preview" style="flex-shrink:0; cursor:pointer;">&#x21BB;</button><div class="agent-menu-wrap" style="position:relative;display:inline-block;flex-shrink:0;"><button type="button" class="editor-btn" id="agentMenuFileBtn" onclick="toggleAgentMenu('file')" style="cursor:pointer;">Agents &#x25BE;</button><div id="agentMenuFile" class="skills-dropdown" style="display:none;right:0;left:auto;top:calc(100% + 6px);bottom:auto;"><button type="button" class="skills-dropdown-item" onclick="openFileInCodex();closeAgentMenus()">&#x26A1; Codex</button><button type="button" class="skills-dropdown-item" onclick="openFileInClaude();closeAgentMenus()">&#x2728; Claude</button><button type="button" class="skills-dropdown-item" onclick="openFileInGemini();closeAgentMenus()">&#x2756; Gemini</button></div></div><button type="button" class="editor-btn" onclick="openShellTerminal()" style="flex-shrink:0; cursor:pointer;">$ Shell</button>
            </div>
        </div>
        <div id="filePreviewBody" class="modal-body repo-preview-body" style="padding:0 0 60px 0;"></div>
    </div>

    <footer class="deep-link-help">
        Deep-link URLs: <code>#/tab/&lt;name&gt;</code>, <code>#/scene/&lt;path&gt;</code>, <code>#/file/&lt;path&gt;</code>. Paths are URL-encoded. Copy the address bar to share the current view.
    </footer>

    <div id="sceneModal" class="modal"><div class="modal-content"><div class="modal-header"><div class="modal-header-inner"><h3 id="modalTitle" style="margin:0; font-size:18px;"></h3><div class="modal-header-controls"><span id="modalHeaderExtras"><div class="modal-font-control"><span style="font-size:10px; color:var(--text-muted);">Size</span><input id="modalFontSize" type="range" min="12" max="36" value="18" oninput="updateFontSize(this.value)" style="width:80px;"></div><div class="modal-font-control"><span style="font-size:10px; color:var(--text-muted);">Font</span><select class="font-select-inline" id="modalFontSelect" onchange="selectFont(this.value)"><option value="reader">Reader</option><option value="literary">Literary</option><option value="inter">Inter</option><option value="georgia">Georgia</option><option value="baskerville">Baskerville</option><option value="sans">Sans</option><option value="mono">Mono</option></select></div><div class="modal-font-control"><span style="font-size:10px; color:var(--text-muted);">Theme</span><select class="font-select-inline" id="modalThemeSelect" onchange="selectTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="docsify">Docsify</option><option value="hopscotch">Hopscotch</option></select></div><button id="modalLineNumbersBtn" type="button" class="editor-btn editor-btn-modal" onclick="toggleLineNumbers()" title="Show source line numbers" style="cursor:pointer; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;">#</button><a id="modalEditorBtn" class="editor-btn editor-btn-modal" target="_blank" title="Open in {{ editor_label }}">&#x2197;</a><button id="modalRefreshBtn" type="button" class="editor-btn editor-btn-modal" onclick="refreshContent()" title="Refresh scene from disk" style="cursor:pointer;">&#x21BB;</button><div class="agent-menu-wrap" style="position:relative;display:inline-block;"><button type="button" class="editor-btn editor-btn-modal" id="agentMenuSceneBtn" onclick="toggleAgentMenu('scene')" style="cursor:pointer;">Agents &#x25BE;</button><div id="agentMenuScene" class="skills-dropdown" style="display:none;right:0;left:auto;top:calc(100% + 6px);bottom:auto;"><button type="button" class="skills-dropdown-item" onclick="openSceneInCodex();closeAgentMenus()">&#x26A1; Codex</button><button type="button" class="skills-dropdown-item" onclick="openSceneInClaude();closeAgentMenus()">&#x2728; Claude</button><button type="button" class="skills-dropdown-item" onclick="openSceneInGemini();closeAgentMenus()">&#x2756; Gemini</button></div></div><button type="button" class="editor-btn editor-btn-modal" onclick="openShellTerminal()" style="cursor:pointer;">$ Shell</button><button id="sceneEditBtn" type="button" class="editor-btn editor-btn-modal" onclick="toggleSceneEdit()" style="cursor:pointer;">&#x270F; Edit</button></span><button id="modalSidebarBtn" class="modal-focus-btn" onclick="setSidebarOpen(document.documentElement.dataset.sidebar==='closed')" title="Toggle sidebar (B)">&#9776;</button><button id="modalFocusBtn" class="modal-focus-btn" onclick="toggleFocusMode()" title="Focus mode (F)">&#x25BE;</button><button class="nav-btn" onclick="navigateScene(-1)">&#x2190;</button><button class="nav-btn" onclick="navigateScene(1)">&#x2192;</button><span class="modal-close" onclick="closeSceneModal()">&times;</span></div></div></div>
        <div class="scene-stat-grid" id="modalStats"></div><div id="modalAlerts" class="modal-alerts"></div><div id="modalBody" class="modal-body"></div><div id="sceneEditBar" class="scene-edit-bar" hidden><span class="scene-edit-status"><span class="scene-edit-dot" id="sceneEditDot"></span><span class="scene-edit-state" id="sceneEditState">Editing</span></span><button type="button" class="scene-edit-save" onclick="saveSceneEdit()" disabled>Save</button><button type="button" class="scene-edit-cancel" onclick="cancelSceneEdit()">Cancel</button><span class="scene-edit-hint" title="Save shortcut">&#x2318;S</span></div></div></div>

    <div id="pmInsertAffordance" class="pm-insert-affordance" hidden title="Insert annotation">+</div>
    <div id="pmAnnotationPopover" class="pm-annotation-popover" hidden>
        <div class="pm-annotation-popover-header">
            <select id="pmAnnotationTag" class="pm-annotation-tag-select">
                <option value="TODO">TODO</option>
                <option value="NOTE">Note</option>
                <option value="continuity">Continuity</option>
                <option value="character">Character</option>
                <option value="theme">Theme</option>
                <option value="question">Question</option>
            </select>
        </div>
        <textarea id="pmAnnotationText" class="pm-annotation-text" rows="3" placeholder="Annotation text..."></textarea>
        <div class="pm-annotation-popover-btns">
            <button type="button" class="pm-annotation-save" onclick="saveAnnotationPopover()">Save</button>
            <button type="button" class="pm-annotation-delete" onclick="deleteAnnotationNode()">Delete</button>
            <button type="button" class="pm-annotation-cancel" onclick="closeAnnotationPopover()">Cancel</button>
        </div>
    </div>

    <div id="terminalPanel" class="terminal-panel dock-bottom" hidden>
        <div id="terminalResizeHandle" class="terminal-resize-handle"></div>
        <div class="terminal-inner">
            <div class="terminal-header">
                <div id="terminalTabs" class="terminal-tabs"></div>
                <button id="termReloadIndicator" class="term-reload-indicator" hidden title="Files changed — click to refresh content, or close terminal to reload" onclick="refreshContent()">&#x25CF; changes pending</button>
                <div class="terminal-header-spacer"></div>
                <div class="terminal-shortcuts">
                    <button class="terminal-header-btn" id="termSelBtn" onmousedown="terminalInsertSel(event)" title="Paste selected text" disabled>+ sel</button>
                    <button class="terminal-header-btn" id="termFileBtn" onclick="terminalInsertFile()" title="Paste @filename" disabled>+ @file</button>
                    <button class="terminal-header-btn" id="termPolishBtn" onclick="terminalPolishFile()" title="Paste a polish-this-file prompt" disabled>+ polish</button>
                    <div class="term-presets-wrap">
                        <button class="terminal-header-btn" id="termPresetsBtn" onclick="terminalTogglePresets()" title="Preset prompts" disabled>Presets &#x25BE;</button>
                        <div id="termPresetsMenu" class="term-presets-menu" style="display:none"></div>
                    </div>
                    <div class="term-presets-wrap">
                        <button class="terminal-header-btn" id="termSkillsBtn" onclick="terminalToggleSkills()" title="Snippet skills" disabled>&#x2728; Skills &#x25BE;</button>
                        <div id="termSkillsMenu" class="term-presets-menu" style="display:none"></div>
                    </div>
                    <span class="terminal-shortcuts-sep"></span>
                </div>
                <div class="terminal-font-control" title="Terminal font size">
                    <span class="terminal-font-control-label">Aa</span>
                    <input id="terminalFontSize" type="range" min="10" max="22" value="13" step="1" oninput="updateTerminalFontSize(this.value)">
                </div>
                <button class="terminal-header-btn" id="terminalDockBtn" onclick="toggleTerminalDock()" title="Dock to right / bottom">&#x21E5;</button>
                <button class="terminal-header-btn" id="terminalClearBtn" onclick="clearTerminal()" title="Clear active tab">Clear</button>
                <button class="terminal-header-btn terminal-close-btn" onclick="closeTerminal()" title="Close all tabs">&times;</button>
            </div>
            <div id="terminalMounts" class="terminal-mounts"></div>
        </div>
    </div>

    <script id="proseview-data">
        let contents = {{ contents_json | safe }};
        const bios = {{ bios_json | safe }};
        let meta = {{ meta_json | safe }};
        const paths = {{ paths_json | safe }};
        let highlightsByPath = {{ highlights_json | safe }};
        const editorScheme = {{ editor_scheme_json | safe }};
        const editorUrlTemplate = {{ editor_url_template_json | safe }};
        const editorLabel = {{ editor_label_json | safe }};
        const repoTree = {{ repo_tree_json | safe }};
        const sidebarTree = {{ sidebar_tree_json | safe }};
        const repoPreviewMax = {{ repo_preview_max }};
        const repoFileByPath = {};
        (function indexRepo(nodes) {
            if (!nodes) return;
            for (const node of nodes) {
                if (node.is_file) repoFileByPath[node.path] = node;
                else indexRepo(node.children);
            }
        })(repoTree);

        const PASS_ORDER = {{ pass_order_json | safe }};
        const SKILLS = {{ skills_json | safe }};
        const presenceChartData = {{ presence_chart_json | safe }};
        const rhythmChartData = {{ rhythm_chart_json | safe }};
        const locationChartData = {{ location_chart_json | safe }};
        const coOccurChartData = {{ cooccur_chart_json | safe }};
        const lexicalScatterChartData = {{ scatter_chart_json | safe }};
    </script>
    <script id="proseview-app">
{{ app_js | safe }}
    </script>
    <script type="module">
        import { Schema } from 'https://esm.sh/prosemirror-model@1';
        import { schema as mdSchema, MarkdownParser, MarkdownSerializer,
                 defaultMarkdownParser, defaultMarkdownSerializer } from 'https://esm.sh/prosemirror-markdown@1';
        import { EditorState, Plugin, PluginKey } from 'https://esm.sh/prosemirror-state@1';
        import { EditorView, Decoration, DecorationSet } from 'https://esm.sh/prosemirror-view@1';
        import { history, undo, redo } from 'https://esm.sh/prosemirror-history@1';
        import { keymap } from 'https://esm.sh/prosemirror-keymap@1';
        import { baseKeymap, toggleMark } from 'https://esm.sh/prosemirror-commands@1';

        const annotationSpec = {
            attrs: { raw: { default: '' } },
            inline: false, group: 'block',
            atom: true, selectable: false,
            parseDOM: [],
            toDOM(node) {
                const preview = node.attrs.raw
                    .replace(/^<!--\s*/, '').replace(/\s*-->$/, '').slice(0, 60);
                return ['div', { class: 'pm-annotation', contenteditable: 'false' }, preview];
            }
        };

        const mySchema = new Schema({
            nodes: mdSchema.spec.nodes.addBefore('paragraph', 'annotation', annotationSpec),
            marks: mdSchema.spec.marks
        });

        const hlPluginKey = new PluginKey('highlights');

        function buildHlPlugin() {
            return new Plugin({
                key: hlPluginKey,
                state: {
                    init() { return DecorationSet.empty; },
                    apply(tr, set) {
                        const next = tr.getMeta(hlPluginKey);
                        if (next !== undefined) return next;
                        return set.map(tr.mapping, tr.doc);
                    }
                },
                props: {
                    decorations(state) { return hlPluginKey.getState(state); }
                }
            });
        }

        window._PM = {
            Schema, EditorState, EditorView, Plugin, PluginKey,
            Decoration, DecorationSet,
            mySchema, mdSchema,
            MarkdownParser, MarkdownSerializer,
            defaultMarkdownParser, defaultMarkdownSerializer,
            history, undo, redo, keymap, baseKeymap, toggleMark,
            hlPluginKey, buildHlPlugin
        };

        // If the scene view is already open, re-render so it uses ProseMirror.
        if (document.documentElement.dataset.view === 'scene' && typeof render === 'function') {
            render();
        }
    </script>
</body>
</html>
