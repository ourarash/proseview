    <div id="book-panel" aria-labelledby="bookTitle">
        <div class="book-header">
            <button type="button" id="bookBackBtn" class="back-btn" onclick="leaveBookView()" aria-keyshortcuts="Escape" title="Back to where you opened the book (Esc)">&#8592; Back</button>
